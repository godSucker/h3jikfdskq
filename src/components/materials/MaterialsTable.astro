---
import { textureUrl } from '@/lib/texture-cdn';
import { t } from '@/lib/i18n';
import type { Locale } from '@/lib/i18n-locales';

export interface SourceInfo {
  type: string;
  where?: string;
  note?: string;
  link?: string;
}

export interface BuildingLevel {
  level: number;
  texture: string;
  description?: string;
}

export interface MaterialRow {
  id: string;
  name: string;
  description?: string;
  texture?: string;
  levels?: BuildingLevel[];
  badge?: string;
  percent?: string | number | null;
  value?: string | number | null;
  rarity?: string | null;
  group?: string;
}

interface Props {
  rows: MaterialRow[];
  sourcesMap?: Record<string, SourceInfo[]>;
  title?: string;
  sectionKey?: string;
  texturePrefix?: string;
  textureExt?: string;
  locale?: Locale;
}

const {
  rows,
  sourcesMap = {},
  title = 'Материалы',
  sectionKey = 'materials',
  texturePrefix = '/materials/',
  textureExt = '.webp',
  locale = 'ru'
} = Astro.props;

const resolveTexture = (row: MaterialRow) => {
  const path = row.texture ? row.texture : `${texturePrefix}${row.id}${textureExt}`;
  return textureUrl(path);
};

const toChip = (s: SourceInfo) => {
  const iconByType: Record<string, string> = {
    reactor: '⚛️',
    gacha: '🎰',
    jackpot: '🎟️',
    event: '🎉',
    shop: '🛒',
    pvp: '⚔️',
    story: '📜',
    dungeon: '🕳️',
    raid: '🐲',
    lab: '🧪',
    bingo: '🎯',
    division: '🏆',
    other: '📦',
  };
  const icon = iconByType[s.type] ?? '📦';
  const where = s.where ? ` — ${s.where}` : '';
  const note = s.note ? ` (${s.note})` : '';
  return `${icon} ${s.type}${where}${note}`;
};

// Строки с одинаковым group идут подряд (предполагается порядок в исходном
// массиве) - перед первой строкой новой группы вставляем заголовок-разделитель.
let prevGroup: string | undefined;
const withGroupHeaders = rows.flatMap((row) => {
  const items: Array<{ kind: 'header' | 'row'; row?: MaterialRow; label?: string }> = [];
  if (row.group && row.group !== prevGroup) {
    items.push({ kind: 'header', label: row.group });
  }
  prevGroup = row.group;
  items.push({ kind: 'row', row });
  return items;
});
---

<section class="materials" data-title={title} data-key={sectionKey} data-no-description={t('materials.table.noDescription', locale)}>
  <div class="header">
    <h2>{title}</h2>
    <div class="controls">
      <input class="mat-search" type="search" placeholder={t('materials.table.search', locale)} />
    </div>
  </div>

  <div class="table" role="table" aria-label={title}>
    <div class="thead" role="rowgroup">
      <div class="tr" role="row">
        <div class="th image" role="columnheader">{t('materials.table.texture', locale)}</div>
        <div class="th name" role="columnheader">{t('materials.table.name', locale)}</div>
        <div class="th desc" role="columnheader">{t('materials.table.description', locale)}</div>
        <div class="th srcs" role="columnheader">{t('materials.table.source', locale)}</div>
      </div>
    </div>

    <div class="tbody" role="rowgroup">
      {withGroupHeaders.map((item) => {
        if (item.kind === 'header') {
          return (
            <div class="group-header" role="row">
              <span>{item.label}</span>
            </div>
          );
        }
        const row = item.row as MaterialRow;
        const srcs = sourcesMap[row.id] ?? [];
        return (
          <div class="tr" role="row" data-id={row.id}>
            <div class="td image" role="cell">
              {row.levels && row.levels.length > 0 ? (
                <div class="level-widget">
                  <div class="level-switch" role="tablist" aria-label={`${t('materials.table.level', locale)} — ${row.name || row.id}`}>
                    {row.levels.map((lvl, i) => (
                      <button
                        type="button"
                        class={`level-btn ${i === 0 ? 'active' : ''}`}
                        data-level={lvl.level}
                        data-texture={textureUrl(lvl.texture)}
                        data-desc={lvl.description || ''}
                        aria-pressed={i === 0}
                      >{lvl.level}</button>
                    ))}
                  </div>
                  <div class="thumb">
                    <img
                      src={textureUrl(row.levels[0].texture)}
                      alt={`${row.name || row.id} — уровень ${row.levels[0].level}`}
                      loading="lazy"
                      draggable="false"
                      oncontextmenu="return false"
                      onerror="this.closest('.thumb').classList.add('noimg')"
                    />
                  </div>
                </div>
              ) : (
                <div class="thumb">
                  <img
                    src={textureUrl(resolveTexture(row))}
                    alt={row.name || row.id}
                    loading="lazy"
                    draggable="false"
                    oncontextmenu="return false"
                    onerror="this.closest('.thumb').classList.add('noimg')"
                  />
                </div>
              )}
            </div>
            <div class="td name" role="cell">
              <div class="name-wrap">
                <strong class="title">{row.name || row.id}</strong>
                <span class="meta">
                  {row.percent && <span class="tag">% {row.percent}</span>}
                  {row.value && <span class="tag">+{row.value}</span>}
                  {row.rarity && <span class="tag">{row.rarity}</span>}
                </span>
              </div>
            </div>
            <div class="td desc" role="cell">
              {row.levels && row.levels.length > 0 ? (
                <span class={`level-desc ${row.levels[0].description ? '' : 'muted'}`}>
                  {row.levels[0].description || t('materials.table.noDescription', locale)}
                </span>
              ) : (
                <>
                  {row.badge && <strong class="desc-badge">{row.badge}</strong>}
                  {row.description ? row.description : <span class="muted">{t('materials.table.noDescription', locale)}</span>}
                </>
              )}
            </div>
            <div class="td srcs" role="cell">
              {srcs.length > 0 ? (
                <div class="chips">
                  {srcs.map((s) => (
                    s.link ? (
                      <a href={s.link} class="chip linkable" title={t('materials.table.clickToOpen', locale)}>{toChip(s)}</a>
                    ) : (
                      <span class="chip">{toChip(s)}</span>
                    )
                  ))}
                </div>
              ) : (
                <span class="muted">—</span>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<script is:inline>
  (function(){
    // Normalize search string: lowercase + remove special chars
    function normalizeSearch(text) {
      if (!text) return '';
      return text
        .toLowerCase()
        .replace(/[^\w\u0400-\u04FF]/g, ''); // Keep only word chars and Cyrillic
    }

    function wire(root){
      if (!root || root.dataset.searchReady === '1') return;
      const input = root.querySelector('.mat-search');
      const body  = root.querySelector('.tbody');
      if (!input || !body) { root.dataset.searchReady = '1'; return; }
      const rows  = Array.from(body.querySelectorAll('.tr'));

      function apply(){
        const q = normalizeSearch(input.value || '');
        for (const r of rows) {
          const id = normalizeSearch(r.getAttribute('data-id') || '');
          const text = normalizeSearch(r.textContent || '');
          const match = !q || id.includes(q) || text.includes(q);
          r.style.display = match ? '' : 'none';
        }
      }
      input.addEventListener('input', apply);
      root.dataset.searchReady = '1';
      apply();
    }

    function wireLevelSwitchers(root){
      const switches = root.querySelectorAll('.level-switch');
      for (const sw of switches) {
        if (sw.dataset.ready === '1') continue;
        sw.dataset.ready = '1';
        const tr = sw.closest('.tr');
        const img = tr && tr.querySelector('.thumb img');
        const descEl = tr && tr.querySelector('.level-desc');
        const noDescLabel = root.dataset.noDescription || 'Описание пока не добавлено';
        const btns = Array.from(sw.querySelectorAll('.level-btn'));
        for (const btn of btns) {
          btn.addEventListener('click', () => {
            for (const b of btns) { b.classList.remove('active'); b.setAttribute('aria-pressed', 'false'); }
            btn.classList.add('active');
            btn.setAttribute('aria-pressed', 'true');
            if (img) {
              img.src = btn.dataset.texture || '';
              const thumb = img.closest('.thumb');
              if (thumb) thumb.classList.remove('noimg');
            }
            if (descEl) {
              const d = btn.dataset.desc || '';
              descEl.textContent = d || noDescLabel;
              descEl.classList.toggle('muted', !d);
            }
          });
        }
      }
    }

    function init(){
      document.querySelectorAll('.materials').forEach((root) => {
        wire(root);
        wireLevelSwitchers(root);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init, { once:true });
    } else {
      init();
    }
  })();
</script>

<style>
  .materials { margin-top: 1rem; }

  .header {
    display: flex; align-items: center; justify-content: space-between;
    gap: 1rem; margin-bottom: 1rem;
  }
  .header h2 { margin: 0; font-size: clamp(1.2rem, 1rem + 1vw, 1.6rem); color: #e2e8f0; }
  .controls { display: flex; gap: 0.75rem; }
  .controls input[type="search"] {
    height: 40px; border-radius: 12px; border: 1px solid rgba(96, 165, 250, 0.28);
    background: rgba(15, 23, 42, 0.92); color: #e2e8f0; padding: 0 0.8rem;
  }
  .controls input::placeholder { color: #94a3b8; }

  .table {
    border: 1px solid rgba(96, 165, 250, 0.28);
    background: rgba(15, 23, 42, 0.92);
    border-radius: 16px;
    overflow: hidden;
  }

  /* Default layout */
  .thead .tr, .tbody .tr {
    display: grid;
    grid-template-columns: 92px minmax(200px, 1fr) minmax(260px, 2fr) minmax(220px, 1.4fr);
    gap: 0 16px;
  }

  /* Bigger image column for Buildings with no cropping. Wide enough for
     Центр Скрещивания (единственный landscape-рендер ~1.3:1 среди зданий,
     остальные портретные) -- одна общая ширина колонки на ВСЕ строки,
     чтобы не ломать выравнивание между ними. */
  .materials[data-key="buildings"] .thead .tr,
  .materials[data-key="buildings"] .tbody .tr {
    grid-template-columns: 240px minmax(200px, 1fr) minmax(260px, 2fr) minmax(220px, 1.4fr);
  }

  .thead .tr {
    background: linear-gradient(180deg, rgba(30, 41, 59, 0.8), rgba(15, 23, 42, 0.8));
    position: sticky; top: 0; z-index: 1;
    border-bottom: 1px solid rgba(96, 165, 250, 0.28);
  }
  .th, .td { padding: 0.9rem 1rem; border-bottom: 1px solid rgba(96, 165, 250, 0.12); }
  .th { font-weight: 600; color: #9ec5fe; font-size: 0.9rem; }

  .tbody .tr:hover { background: rgba(30, 58, 138, 0.18); }

  .group-header {
    padding: 0.6rem 1rem;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #9ec5fe;
    background: linear-gradient(180deg, rgba(30, 41, 59, 0.6), rgba(15, 23, 42, 0.6));
    border-bottom: 1px solid rgba(96, 165, 250, 0.2);
  }

  /* уровень-свитчер (инкубатор/скрещивалка) */
  .level-widget { display: flex; flex-direction: column; align-items: center; gap: 0.4rem; margin-left: 3px; }
  .level-switch { display: flex; gap: 0.3rem; }
  .level-btn {
    appearance: none; width: 24px; height: 24px; padding: 0;
    border: 1px solid rgba(96, 165, 250, 0.35);
    background: rgba(15, 23, 42, 0.9); color: #94a3b8;
    border-radius: 999px; font-size: 0.74rem; font-weight: 700; line-height: 1;
    cursor: pointer; display: grid; place-items: center;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease, background 0.18s ease, color 0.18s ease;
  }
  .level-btn:hover { border-color: rgba(96, 165, 250, 0.7); color: #e2e8f0; transform: translateY(-1px); }
  .level-btn.active {
    background: linear-gradient(180deg, rgba(59, 130, 246, 0.45), rgba(15, 23, 42, 0.95));
    border-color: rgba(96, 165, 250, 0.85); color: #fff;
    box-shadow: 0 6px 14px rgba(37, 99, 235, 0.35);
  }
  .level-btn:focus-visible { outline: 2px solid rgba(96, 165, 250, 0.8); outline-offset: 2px; }

  .thumb {
    width: 84px;
    height: auto;
    border-radius: 14px;
    overflow: visible;
    position: relative;
    padding: 10px; box-sizing: border-box;
    background:
      radial-gradient(60% 60% at 30% 30%, rgba(59, 130, 246, 0.18), transparent 60%),
      radial-gradient(60% 60% at 70% 70%, rgba(147, 197, 253, 0.15), transparent 60%),
      linear-gradient(180deg, rgba(15, 23, 42, 0.85), rgba(15, 23, 42, 0.95));
    display: grid; place-items: center;
  }

  /* Larger thumbs for Buildings (no crop, fully visible) */
  .materials[data-key="buildings"] .thumb {
    width: 220px;
    height: auto;
    padding: 12px;
    border-radius: 16px;
  }

  .thumb img {
    max-width: 100%;
    max-height: 180px;
    width: auto;
    height: auto;
    display: block;
    margin: auto;
    object-fit: contain;
    object-position: center;
    image-rendering: auto;
    transform: translateZ(0);
  }

  .materials[data-key="buildings"] .thumb img {
    max-height: 200px;
  }


  .thumb.noimg::after { content: 'No image'; color: #64748b; font-size: 0.7rem; letter-spacing: 0.06em; }

  .name .title { color: #e2e8f0; }
  .meta { display: inline-flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.35rem; }

  .tag {
    background: rgba(59, 130, 246, 0.15); color: #bfdbfe;
    padding: 0.1rem 0.5rem; border-radius: 999px; font-size: 0.78rem; letter-spacing: 0.04em;
  }

  .muted { color: #94a3b8; }

  .desc-badge {
    display: inline-block; color: #fbbf24; margin-right: 0.4rem;
    background: rgba(251, 191, 36, 0.12); border: 1px solid rgba(251, 191, 36, 0.3);
    border-radius: 6px; padding: 0.05rem 0.4rem; font-size: 0.82rem;
  }

  .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .chip {
    background: rgba(34, 197, 94, 0.16); color: #a7f3d0;
    border: 1px solid rgba(16, 185, 129, 0.25);
    padding: 0.2rem 0.55rem; border-radius: 999px; font-size: 0.78rem;
    text-decoration: none;
    transition: all 0.2s;
  }
  
  .chip.linkable:hover {
    background: rgba(34, 197, 94, 0.3);
    border-color: rgba(16, 185, 129, 0.5);
    color: #ecfdf5;
    cursor: pointer;
    box-shadow: 0 0 10px rgba(16, 185, 129, 0.2);
  }

  /* === Orbs & Boosters sizing normalization === */
  /* Все текстуры (сферы, бустеры, материалы) физически нормализованы скриптом normalize-boosters.py
     к единому квадратному холсту 256x256 с автообрезкой пустоты.
     Это гарантирует 100% одинаковый размер всех элементов. */

  .materials[data-title="Сферы"] .thumb,
  .materials[data-title="Бустеры"] .thumb {
    width: var(--orb-size-container-large);
    height: var(--orb-size-container-large);
    padding: 8px;
    flex-shrink: 0;
  }

  .materials[data-title="Сферы"] .thumb img,
  .materials[data-title="Бустеры"] .thumb img {
    width: var(--orb-size-img-large);
    height: var(--orb-size-img-large);
    object-fit: contain;
    filter: drop-shadow(0 4px 8px rgba(0,0,0,0.45));
  }

  @media (max-width: 980px) {
    .thead .tr, .tbody .tr { grid-template-columns: 92px minmax(160px, 1fr) minmax(200px, 2fr) minmax(160px, 1.2fr); }
    .materials[data-key="buildings"] .thead .tr,
    .materials[data-key="buildings"] .tbody .tr { grid-template-columns: 220px minmax(160px, 1fr) minmax(200px, 2fr) minmax(160px, 1.2fr); }
    .th, .td { padding: 0.75rem 0.8rem; }
  }
  @media (max-width: 720px) {
    .header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
    .controls { width: 100%; }
    .controls input[type="search"] { width: 100%; box-sizing: border-box; }

    .thead { display: none; }
    .tbody .tr {
      grid-template-columns: 72px 1fr;
      grid-auto-rows: auto; gap: 0.25rem 0.6rem;
      padding: 0.5rem 0.15rem; border-bottom: 1px solid rgba(96, 165, 250, 0.12);
    }
    .materials[data-key="buildings"] .tbody .tr {
      grid-template-columns: 150px 1fr;
    }
    .td.name { grid-column: 2 / -1; }
    .td.desc { grid-column: 1 / -1; padding-top: 0; font-size: 0.82rem; }
    .td.srcs { grid-column: 1 / -1; padding-top: 0; }

    .thumb {
      width: 64px;
      padding: 6px;
    }
    .thumb img { max-height: 120px; }
    .materials[data-key="buildings"] .thumb { width: 138px; padding: 8px; }
    .materials[data-key="buildings"] .thumb img { max-height: 140px; }

    .materials[data-title="Сферы"] .thumb,
    .materials[data-title="Бустеры"] .thumb {
      width: 64px;
      height: 64px;
      padding: 6px;
    }
    .materials[data-title="Сферы"] .thumb img,
    .materials[data-title="Бустеры"] .thumb img {
      width: 48px;
      height: 48px;
    }

    .th, .td { padding: 0.5rem 0.6rem; }
    .chips { gap: 0.3rem; }
    .chip { font-size: 0.72rem; padding: 0.15rem 0.45rem; }
  }

  @media (max-width: 400px) {
    .tbody .tr {
      grid-template-columns: 60px 1fr;
      gap: 0.2rem 0.4rem;
      padding: 0.4rem 0.1rem;
    }
    .materials[data-key="buildings"] .tbody .tr {
      grid-template-columns: 120px 1fr;
    }
    .thumb { width: 52px; padding: 4px; }
    .thumb img { max-height: 100px; }
    .materials[data-key="buildings"] .thumb { width: 112px; }
    .materials[data-title="Сферы"] .thumb,
    .materials[data-title="Бустеры"] .thumb { width: 52px; height: 52px; padding: 4px; }
    .materials[data-title="Сферы"] .thumb img,
    .materials[data-title="Бустеры"] .thumb img { width: 40px; height: 40px; }
    .name .title { font-size: 0.88rem; }
    .td.desc { font-size: 0.78rem; }
  }

  /* QHD upscaling */
  @media (min-width: 1921px) {
    .thumb { width: 105px; padding: 12px; }
    .thumb img { max-height: 225px; }
    .materials[data-key="buildings"] .thead .tr,
    .materials[data-key="buildings"] .tbody .tr { grid-template-columns: 300px minmax(200px, 1fr) minmax(260px, 2fr) minmax(220px, 1.4fr); }
    .materials[data-key="buildings"] .thumb { width: 280px; padding: 15px; }
    .materials[data-key="buildings"] .thumb img { max-height: 250px; }
    .materials[data-title="Сферы"] .thumb,
    .materials[data-title="Бустеры"] .thumb {
      width: calc(var(--orb-size-container-large) * 1.25);
      height: calc(var(--orb-size-container-large) * 1.25);
      padding: 10px;
    }
    .materials[data-title="Сферы"] .thumb img,
    .materials[data-title="Бустеры"] .thumb img {
      width: calc(var(--orb-size-img-large) * 1.25);
      height: calc(var(--orb-size-img-large) * 1.25);
    }
  }
</style>
