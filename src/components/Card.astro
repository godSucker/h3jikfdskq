---
// Карточка для раздела или симулятора.
// Принимает свойства: title (string), desc (string), href (string), icon (optional URL),
// art (optional URL) - высокая картинка-персонаж у правого нижнего края карточки.
import { textureUrl } from '@/lib/texture-cdn';

const { title, desc, href, icon, art } = Astro.props;
---

<a href={href} class:list={['card', { 'card--with-art': art }]}>
  {art ? <img class="card-art" src={textureUrl(art)} alt="" loading="lazy" decoding="async" /> : null}
  {icon ? (
    <div class="card-icon">
      <img src={textureUrl(icon)} alt="" />
    </div>
  ) : null}
  <h3 class="card-title">{title}</h3>
  <p class="card-desc">{desc}</p>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    padding: 1rem;
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 0.75rem; /* Скруглил углы */
    text-decoration: none;
    color: inherit;
    transition: all 0.2s;
    min-height: 140px; /* Увеличил высоту */
  }
  
  /* Картинка-персонаж: прижата к правому нижнему краю. Карточки на десктопе
     бывают узкими (~230px на 1280), поэтому размер арта считается от ширины
     самой карточки (container query), а не фиксированный: иначе отступ под
     него сжимает заголовок до слова в строке и тянет весь ряд вверх. */
  .card--with-art {
    position: relative;
    overflow: hidden;
    container-type: inline-size;
    --card-art-h: min(11rem, 70cqw);
  }
  .card-art {
    position: absolute;
    right: 0.25rem;
    bottom: 0;
    height: var(--card-art-h);
    /* На телефоне карточка бывает ниже арта - без потолка голову срезало бы
       overflow:hidden сверху. */
    max-height: calc(100% - 0.5rem);
    width: auto;
    pointer-events: none;
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.45));
  }
  /* Ширина арта ~0.59 от высоты; часть её уходит в собственный padding
     карточки, поэтому текст отодвигаем на остаток. Только описание:
     заголовок стоит выше головы персонажа и идёт на всю ширину - иначе на
     узкой карточке он ломается по слову в строке. */
  .card--with-art .card-desc {
    position: relative;
    padding-right: max(0px, calc(var(--card-art-h) * 0.59 - 1rem));
  }

  .card:hover {
    border-color: #58a6ff;
    transform: translateY(-2px);
  }
  
  .card:active {
    transform: translateY(0);
  }
  
  .card-icon {
    display: flex;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .card-icon img {
    width: 48px;
    height: 48px;
    object-fit: contain;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.4));
  }
  
  .card-title {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    line-height: 1.3;
    color: #e2e8f0;
  }
  
  .card-desc {
    margin: 0;
    font-size: 0.85rem;
    color: #94a3b8;
    line-height: 1.5;
    /* Отступ для мобильных, чтобы текст не прилипал к краю */
    padding-bottom: 0.25rem; 
  }
  
  /* Tablet styles */
  @media (min-width: 768px) {
    .card {
      padding: 1.5rem;
      min-height: 160px;
    }
    
    .card-icon img {
      width: 56px;
      height: 56px;
      margin-bottom: 0.75rem;
    }
    
    .card-title {
      font-size: 1.25rem;
    }
    
    .card-desc {
      font-size: 0.95rem;
    }
  }
  
  /* Desktop styles */
  @media (min-width: 1024px) {
    .card {
      padding: 1.75rem;
      min-height: 180px;
    }
    
    .card-icon img {
      width: 64px;
      height: 64px;
      margin-bottom: 1rem;
    }
    
    .card-title {
      font-size: 1.35rem;
      margin-bottom: 0.5rem;
    }
    
    .card-desc {
      font-size: 1rem;
    }
  }
</style>
