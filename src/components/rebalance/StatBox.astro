---
import { t, localeFromAstro } from '@/lib/i18n';

interface Props {
  oldVal: number | null;
  newVal: number | null;
  aoe?: boolean;
}
const { oldVal, newVal, aoe = false } = Astro.props;

const locale = localeFromAstro(Astro.currentLocale);
const INTL_LOCALE: Record<string, string> = { ru: 'ru-RU', en: 'en-US', es: 'es-ES', fr: 'fr-FR', de: 'de-DE', pt: 'pt-BR', it: 'it-IT', tr: 'tr-TR', nl: 'nl-NL' };
const fmtNum = (n: number | null) => (n == null ? '—' : n.toLocaleString(INTL_LOCALE[locale] ?? 'ru-RU'));

// Только цвет направления (зелёный/красный), без числового % изменения -
// автор сайта решил, что процент ребаланса только мешает восприятию.
const directionCls = (): string => {
  if (oldVal == null || newVal == null || oldVal === 0) return '';
  const pct = ((newVal - oldVal) / oldVal) * 100;
  if (Math.abs(pct) < 0.005) return '';
  return pct > 0 ? 'up' : 'down';
};

const cls = directionCls();
---

<div class="statbox">
  {aoe && <span class="aoe-badge" title={t('rebalance.aoeTitle', locale)}>AOE</span>}
  <span class="vals">
    <span class="old-val">{fmtNum(oldVal)}</span>
    <span class="arrow">→</span>
    <span class={`new-val ${cls}`}>{fmtNum(newVal)}</span>
  </span>
</div>

<style>
  .statbox {
    display: flex;
    align-items: baseline;
    line-height: 1.3;
    min-width: 0;
  }
  .vals {
    font-variant-numeric: tabular-nums;
    font-size: 0.85rem;
    white-space: nowrap;
  }
  .old-val {
    color: #94a3b8;
  }
  .new-val {
    color: #e2e8f0;
    font-weight: 700;
  }
  .new-val.up {
    color: #4ade80;
  }
  .new-val.down {
    color: #f87171;
  }
  .arrow {
    color: #64748b;
    margin: 0 0.2rem;
  }
  .aoe-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 13px;
    padding: 0 3px;
    margin-right: 0.3rem;
    border-radius: 4px;
    background: rgba(96, 165, 250, 0.16);
    border: 1px solid rgba(96, 165, 250, 0.4);
    color: #93c5fd;
    font-size: 0.5rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    line-height: 1;
    flex-shrink: 0;
    align-self: center;
  }
</style>
