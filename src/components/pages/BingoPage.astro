---
export const prerender = true;
import BaseLayout from '@/layouts/BaseLayout.astro';
import bingosData from '@/data/bingos.json';
import mutantNamesData from '@/data/mutant_names.json';
import { getMutantTexturePath, getRewardTexturePath, getRewardLabel } from '@/lib/bingo-textures';
import { bingoLabelL } from '@/lib/mutant-dicts';
import { textureUrl } from '@/lib/texture-cdn';
import { t, localeFromAstro } from '@/lib/i18n';
import { getLocalizedMutantNames } from '@/lib/mutant-names-i18n';
import { baseMutantId } from '@/lib/utils';
import { bingoBoardHash } from '@/lib/bingo-board-hash';
import BingoMutantModal from '@/components/bingo/BingoMutantModal.svelte';

const locale = localeFromAstro(Astro.currentLocale);
const { names, obtainNames } = getLocalizedMutantNames(locale);

interface BingoMutant {
  specimenId: string;
  skin: string;
}

interface BingoReward {
  name: string;
  amount: number;
  type: 'entity' | 'hardcurrency' | 'softcurrency';
  skin?: string;
}

interface Bingo {
  title: string;
  id: string;
  mutants: BingoMutant[];
  rewards: BingoReward[];
  columns?: number;
  archived?: boolean;
}

const bingos: Bingo[] = bingosData as Bingo[];
// Архивные (снятые из игры) бинго уходят в хвост списка вкладок, но порядок
// среди активных/среди архивных не меняется (стабильная сортировка).
const sortedBingos: Bingo[] = [...bingos].sort((a, b) => Number(!!a.archived) - Number(!!b.archived));
const firstArchivedIndex = sortedBingos.findIndex((b) => b.archived);

// Категории-фильтры над полосой вкладок. Правила по префиксам/суффиксам id, а не
// только по списку: sync-bingo добавляет новые доски сам, и любая незнакомая
// попадает в "misc" - вкладка не должна пропасть из-за того, что её забыли
// вписать сюда. Архив эксклюзивен: archived-доска живёт ТОЛЬКО в нём.
type BingoCategory = 'research' | 'archive' | 'newMutants' | 'events' | 'skins' | 'cross' | 'misc';
const CROSS_IDS = new Set([
  'cross_mutation', 'bingo_bronze', 'bingo_silver', 'bingo_gold', 'bingo_plat',
  'Starter', 'starter_plat',
]);
function bingoCategory(b: Bingo): BingoCategory {
  if (b.archived) return 'archive';
  const id = b.id;
  if (id.startsWith('research_')) return 'research';
  if (id.endsWith('_mutants')) return 'newMutants';
  if (id.endsWith('_skins')) return 'skins';
  if (CROSS_IDS.has(id)) return 'cross';
  if (id.endsWith('_events') || id.startsWith('event') || id.startsWith('anniversary_') || id.endsWith('years')) {
    return 'events';
  }
  return 'misc';
}
const CATEGORY_ORDER: BingoCategory[] = ['research', 'archive', 'newMutants', 'events', 'skins', 'cross', 'misc'];
const CATEGORY_LABEL_KEY: Record<BingoCategory, string> = {
  research: 'bingo.cat.research',
  archive: 'bingo.cat.archive',
  newMutants: 'bingo.cat.newMutants',
  events: 'bingo.cat.events',
  skins: 'bingo.cat.skins',
  cross: 'bingo.cat.cross',
  misc: 'bingo.cat.misc',
};
const categoryByBoardId = new Map(sortedBingos.map((b) => [b.id, bingoCategory(b)]));
const presentCategories = CATEGORY_ORDER.filter((c) => sortedBingos.some((b) => bingoCategory(b) === c));

const GENE_ICONS = {
  A: '/genes/icon_gene_a.webp',
  B: '/genes/icon_gene_b.webp',
  C: '/genes/icon_gene_c.webp',
  D: '/genes/icon_gene_d.webp',
  E: '/genes/icon_gene_e.webp',
  F: '/genes/icon_gene_f.webp',
};


function formatBingoTitle(title: string, id: string): string {
  const labelById = bingoLabelL(id, locale);
  if (labelById && labelById !== id) return labelById;
  const labelByTitle = bingoLabelL(title, locale);
  if (labelByTitle && labelByTitle !== title) return labelByTitle;

  return title
    .replace(/^--------/, "")
    .replace(/_/g, " ")
    .replace(/([a-z])([A-Z])/g, "$1 $2")
    .split(" ")
    .map(word => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase())
    .join(" ");
}

// mutant_names.json - RU-канон, ключи в точном регистре игры (incl. суффиксы
// звёзд типа _Platinum). Для остальных 8 языков используем names.{lang}.json
// (тот же словарь, что TierListPage.astro) по базовому id - звёздные варианты
// визуально один и тот же мутант, имя не меняется от звезды.
function getMutantName(specimenId: string): string {
  const mutantNames = mutantNamesData as Record<string, string>;
  if (locale === 'ru') return mutantNames[specimenId] || specimenId;
  return names[baseMutantId(specimenId)]?.name || mutantNames[specimenId] || specimenId;
}

function getBingoLayout(bingo: Bingo) {
  const count = bingo.mutants.length;
  let cols = bingo.columns || Math.ceil(Math.sqrt(count));
  if (count === 12 && !bingo.columns) cols = 4;
  const rows = Math.ceil(count / cols);

  const hasHeaders = [
    'Starter', '2025_skins', '2025_mutants', '2025_events',
    '2026_events', '2026_skins', '2026_mutants',
    'anniversary_25', 'cross_mutation',
    'research_1', 'research_2', 'research_3', 'research_4', 'research_5',
    'research_6', 'research_7', 'research_8', 'research_9', 'research_10', 'research_11',
    'reactor', 'legend', 'bingo_bronze', 'bingo_silver', 'bingo_gold', 'bingo_plat',
    'zodiac', 'zodiac_silver', 'events', 'amazons', 'rumble', 'starter_plat',
    'heroic', 'event_2019', 'event_2020', 'event_2021', 'event_2022', 'event_2023', 'event_2024',
    'event_xmas2016', 'event_xmas2017', 'event_xmas2018', 'event_xmas2019', 'event_xmas2020',
    'event_xmas2021', 'event_xmas2022', 'event_xmas2023', 'event_xmas2024', 'event_xmas2025',
    'anniversary_21', 'anniversary_24', 'anniversary_26', '10years'
  ].includes(bingo.id);
  const topHeaders: string[] = Array(cols).fill('');
  const sideHeaders: string[] = Array(rows).fill('');

  if (bingo.id === 'Starter') {
    topHeaders[1] = GENE_ICONS.A;
    topHeaders[2] = GENE_ICONS.B;
    topHeaders[3] = GENE_ICONS.C;
  } else if ([
    '2025_skins', '2025_mutants', '2025_events', '2026_skins', '2026_mutants', '2026_events',
    'event_xmas2025', 'anniversary_26',
  ].includes(bingo.id)) {
    for (let i = 0; i < cols; i++) topHeaders[i] = `/bingo/up_${i + 1}.webp`;
    for (let i = 0; i < rows; i++) sideHeaders[i] = `/bingo/up_${i + 1}.webp`;
  } else if (bingo.id === 'anniversary_25') {
    // Используем первые 4 иконки от "Скины 2025"
    for (let i = 0; i < cols && i < 4; i++) topHeaders[i] = `/bingo/up_${i + 1}.webp`;
    for (let i = 0; i < rows && i < 4; i++) sideHeaders[i] = `/bingo/up_${i + 1}.webp`;
  } else if (['zodiac', 'zodiac_silver'].includes(bingo.id)) {
    // Зодиак и Серебряные Зодиаки - фоновые иконки
    for (let i = 0; i < cols; i++) topHeaders[i] = `/bingo/bingo_zodiac_up_${i + 1}.webp`;
    for (let i = 0; i < rows; i++) sideHeaders[i] = `/bingo/bingo_zodiac_${i + 1}.webp`;
  } else if (bingo.id === 'events') {
    // Праздники - фоновые иконки
    for (let i = 0; i < cols; i++) topHeaders[i] = `/bingo/events_up_${i + 1}.webp`;
    for (let i = 0; i < rows; i++) sideHeaders[i] = `/bingo/bingo_events_${i + 1}.webp`;
  } else if (bingo.id === 'amazons') {
    // Серебряные амазонки - фоновые иконки
    for (let i = 0; i < cols; i++) topHeaders[i] = `/bingo/multi_up_${i + 1}.webp`;
    for (let i = 0; i < rows; i++) sideHeaders[i] = `/bingo/bingo_amazons_${i + 1}.webp`;
  } else if (bingo.id === 'rumble') {
    // Грохот - фоновые иконки
    for (let i = 0; i < cols; i++) topHeaders[i] = `/bingo/multi_up_${i + 1}.webp`;
    for (let i = 0; i < rows; i++) sideHeaders[i] = `/bingo/events_left_${i + 1}.webp`;
  } else if (bingo.id === 'starter_plat') {
    // Платиновое бинго - как Базовое (Starter)
    topHeaders[1] = GENE_ICONS.A;
    topHeaders[2] = GENE_ICONS.B;
    topHeaders[3] = GENE_ICONS.C;
  } else if (bingo.id === 'heroic') {
    // Герои - по аналогии с Грохот
    for (let i = 0; i < cols; i++) topHeaders[i] = `/bingo/multi_up_${i + 1}.webp`;
    for (let i = 0; i < rows; i++) sideHeaders[i] = `/bingo/events_left_${i + 1}.webp`;
  } else if (bingo.id === 'event_2019') {
    // Ивенты 2019 - фоновые иконки
    for (let i = 0; i < cols; i++) topHeaders[i] = `/bingo/events_up_${i + 1}.webp`;
    for (let i = 0; i < rows; i++) sideHeaders[i] = `/bingo/bingo_events_${i + 1}.webp`;
  } else if (bingo.id === 'event_2020') {
    // Ивенты 2020 - фоновые иконки
    for (let i = 0; i < cols; i++) topHeaders[i] = `/bingo/events_up_${i + 1}.webp`;
    for (let i = 0; i < rows; i++) sideHeaders[i] = `/bingo/events_left_${i + 1}.webp`;
  } else if ([
    'event_2021', 'event_2022', 'event_2023', 'event_2024',
    'event_xmas2016', 'event_xmas2017', 'event_xmas2018', 'event_xmas2019', 'event_xmas2020',
    'event_xmas2021', 'event_xmas2022', 'event_xmas2023', 'event_xmas2024',
    'anniversary_21', 'anniversary_24', '10years',
  ].includes(bingo.id)) {
    // Ёлки/годовщины/ивенты одного визуального семейства - одинаковые фоновые иконки
    for (let i = 0; i < cols; i++) topHeaders[i] = `/bingo/multi_up_${i + 1}.webp`;
    for (let i = 0; i < rows; i++) sideHeaders[i] = `/bingo/events_left_${i + 1}.webp`;
  } else if (['cross_mutation', 'research_1', 'research_2', 'research_3', 'research_4', 'research_5',
              'research_6', 'research_7', 'research_8', 'research_9', 'research_10', 'research_11',
              'reactor', 'legend', 'bingo_bronze', 'bingo_silver', 'bingo_gold', 'bingo_plat'].includes(bingo.id)) {
    const genes = [GENE_ICONS.A, GENE_ICONS.B, GENE_ICONS.C, GENE_ICONS.D, GENE_ICONS.E, GENE_ICONS.F];
    for (let i = 0; i < cols; i++) topHeaders[i] = genes[i] || '';
    for (let i = 0; i < rows; i++) sideHeaders[i] = genes[i] || '';
  }

  const expectedWithCompletion = rows + cols + 1;
  const expectedNoCompletion = rows + cols;
  const hasCompletion = bingo.rewards.length === expectedWithCompletion;
  const hasLineRewards = hasCompletion || bingo.rewards.length === expectedNoCompletion;

  let rowRewards: BingoReward[] = [];
  let colRewards: BingoReward[] = [];
  let completionReward: BingoReward | null = null;
  let otherRewards: BingoReward[] = [];

  if (hasLineRewards) {
    rowRewards = bingo.rewards.slice(0, rows);
    colRewards = bingo.rewards.slice(rows, rows + cols);
    if (hasCompletion) {
      completionReward = bingo.rewards[bingo.rewards.length - 1];
    }
  } else {
    otherRewards = bingo.rewards;
  }

  return { rows, cols, hasLineRewards, rowRewards, colRewards, completionReward, otherRewards, hasHeaders, topHeaders, sideHeaders };
}

function getSubBingos(bingo: Bingo): Bingo[] {
  if (bingo.mutants.length === 32 && bingo.rewards.length === 18) {
    return [
      {
        ...bingo,
        id: `${bingo.id}_part1`,
        title: `${bingo.title} 1`,
        mutants: bingo.mutants.slice(0, 16),
        rewards: bingo.rewards.slice(0, 9)
      },
      {
        ...bingo,
        id: `${bingo.id}_part2`,
        title: `${bingo.title} 2`,
        mutants: bingo.mutants.slice(16, 32),
        rewards: bingo.rewards.slice(9, 18)
      }
    ];
  }
  return [bingo];
}

// Блок "Плавильня и кузня": какие мутанты нужно собрать, чтобы получить золотую
// плавильню (Building_HC_2) / кузню (Building_HC_1) наградой бинго. Выводится из
// самих наград тем же getBingoLayout(), что рисует доски (награды идут строки ->
// колонки -> приз за всю доску), поэтому не расходится с сеткой и подхватит новые
// доски автоматически. Specimen_FF_98 - заглушка "пока нет", в список не берём.
const GOLD_BUILDING_IDS = ['Building_HC_2', 'Building_HC_1'];
interface GoldSource {
  building: BingoReward;
  boardId: string;
  boardTitle: string;
  scope: 'row' | 'col' | 'whole';
  n: number;
  headerIcon: string;
  mutants: BingoMutant[];
}
const goldSources: GoldSource[] = [];
for (const bingo of sortedBingos) {
  const { cols, hasLineRewards, rowRewards, colRewards, completionReward, topHeaders, sideHeaders } = getBingoLayout(bingo);
  if (!hasLineRewards) continue;
  const real = (m: BingoMutant) => m && m.specimenId !== 'Specimen_FF_98';
  const push = (building: BingoReward, scope: GoldSource['scope'], n: number, mutants: BingoMutant[], headerIcon = '') => {
    goldSources.push({
      building, boardId: bingo.id, boardTitle: formatBingoTitle(bingo.title, bingo.id),
      scope, n, headerIcon, mutants: mutants.filter(real),
    });
  };
  rowRewards.forEach((rw, r) => {
    if (GOLD_BUILDING_IDS.includes(rw.name)) push(rw, 'row', r + 1, bingo.mutants.slice(r * cols, (r + 1) * cols), sideHeaders[r]);
  });
  colRewards.forEach((rw, c) => {
    if (GOLD_BUILDING_IDS.includes(rw.name)) {
      push(rw, 'col', c + 1, bingo.mutants.filter((_, i) => i % cols === c), topHeaders[c]);
    }
  });
  if (completionReward && GOLD_BUILDING_IDS.includes(completionReward.name)) {
    push(completionReward, 'whole', 0, bingo.mutants);
  }
}
// Плавильни выше кузен, внутри - порядок вкладок (sort стабильный).
goldSources.sort((a, b) => GOLD_BUILDING_IDS.indexOf(a.building.name) - GOLD_BUILDING_IDS.indexOf(b.building.name));
const goldPanelIndex = sortedBingos.length;
const GOLD_TAB_ID = 'gold_buildings';

const i18nShareCopied = t('bingo.share.copied', locale);
const i18nSharePromptLabel = t('bingo.share.promptLabel', locale);
---

<BaseLayout title={t('bingo.pageTitle', locale)} description={t('bingo.pageDescription', locale)}>
  <section class="intro">
    <div class="intro-header">
      <img src="https://cdn.archivist-library.com/etc/icon_bingo.webp" alt={t('bingo.pageTitle', locale)} class="bingo-icon" />
      <div>
        <h1>{t('bingo.pageTitle', locale)}</h1>
        <p>{t('bingo.subtitle', locale)}</p>
      </div>
    </div>
  </section>

  <div class="bingo-cats" role="group" aria-label={t('bingo.pageTitle', locale)}>
    <button type="button" class="bingo-cat-pill" data-category="all" aria-pressed="true">{t('bingo.cat.all', locale)}</button>
    {presentCategories.map((cat) => (
      <button type="button" class="bingo-cat-pill" data-category={cat} aria-pressed="false">{t(CATEGORY_LABEL_KEY[cat], locale)}</button>
    ))}
    {goldSources.length > 0 && (
      <button type="button" class="bingo-cat-pill gold" data-category="gold" aria-pressed="false">{t('bingo.cat.gold', locale)}</button>
    )}
  </div>

  <div class="bingo-tabs">
    {sortedBingos.map((bingo, idx) => (
      <>
        {idx === firstArchivedIndex && idx > 0 && <span class="bingo-tabs-separator" aria-hidden="true">|</span>}
        <button
          class="bingo-tab"
          type="button"
          data-bingo-index={idx}
          data-bingo-id={bingo.id}
          data-category={categoryByBoardId.get(bingo.id)}
          aria-selected={idx === 0}
        >
          <span class={`bingo-icon-span icon-${bingo.id}`}></span>
          <span class="bingo-tab-label">
            {formatBingoTitle(bingo.title, bingo.id)}
            {bingo.archived && <span class="bingo-archived-tag">{t('bingo.archived', locale)}</span>}
          </span>
        </button>
      </>
    ))}
    {goldSources.length > 0 && (
      <button
        class="bingo-tab"
        type="button"
        data-bingo-index={goldPanelIndex}
        data-bingo-id={GOLD_TAB_ID}
        data-category="gold"
        aria-selected="false"
      >
        <img class="bingo-icon-span" src={textureUrl('/buildings/gold_furnace_hc2.png')} alt="" loading="lazy" />
        <span class="bingo-tab-label">{t('bingo.cat.gold', locale)}</span>
      </button>
    )}
  </div>

  <div class="bingo-content">
    {sortedBingos.map((originalBingo, bingoIdx) => {
      const subBingos = getSubBingos(originalBingo);

      return (
        <div
          class="bingo-panel"
          data-bingo-index={bingoIdx}
          data-bingo-id={originalBingo.id}
          data-bingo-hash={bingoBoardHash(originalBingo)}
          hidden={bingoIdx !== 0}
        >
          <div class="bingo-card">
            <div class="bingo-card-header">
              <div class="bingo-card-title-wrapper">
                <span class={`bingo-header-icon icon-${originalBingo.id}`}></span>
                <h2 class="bingo-card-title">{formatBingoTitle(originalBingo.title, originalBingo.id)}</h2>
                {originalBingo.archived && <span class="bingo-archived-tag card">{t('bingo.archived', locale)}</span>}
              </div>
              <button type="button" class="bingo-share-btn" data-share-bingo-id={originalBingo.id} title={t('bingo.shareTitle', locale)}>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
                <span class="bingo-share-label">{t('bingo.share', locale)}</span>
              </button>
            </div>

            <div class="bingo-sub-grids">
              {subBingos.map((bingo, subIdx) => {
                const layout = getBingoLayout(bingo);
                const {
                  rows, cols, hasLineRewards, rowRewards, colRewards,
                  completionReward, otherRewards, hasHeaders, topHeaders, sideHeaders
                } = layout;

                const headerOffset = hasHeaders ? 1 : 0;
                const rewardOffset = hasLineRewards ? 1 : 0;

                const totalCols = cols + headerOffset + rewardOffset;

                return (
                  <div class={`bingo-sub-grid-wrapper ${subBingos.length > 1 ? "has-separator" : ""}`}>
                    {subBingos.length > 1 && (
                       <h3 class="sub-bingo-title">{t('bingo.part', locale)} {subIdx + 1}</h3>
                    )}

                    <div class="bingo-board-wrapper">
                      <div
                        class="bingo-grid"
                        style={`
                          grid-template-columns: repeat(${totalCols}, 1fr);
                          --total-cols: ${totalCols};
                        `}
                      >
                        {hasHeaders && (
                          <>
                            <div class="grid-cell empty"></div>
                            {topHeaders.map((icon) => (
                              <div class="grid-cell header-cell top">
                                {icon && <img src={textureUrl(icon)} alt="" class="header-icon-img" />}
                              </div>
                            ))}
                            {hasLineRewards && <div class="grid-cell empty"></div>}
                          </>
                        )}

                        {Array.from({ length: rows }).map((_, r) => (
                          <>
                            {hasHeaders && (
                              <div class="grid-cell header-cell side">
                                {sideHeaders[r] && <img src={textureUrl(sideHeaders[r])} alt="" class="header-icon-img" />}
                              </div>
                            )}

                            {Array.from({ length: cols }).map((_, c) => {
                              const idx = r * cols + c;
                              const mutant = bingo.mutants[idx];
                              if (!mutant) return <div class="grid-cell empty"></div>;

                              const isMissing = mutant.specimenId === 'Specimen_FF_98';
                              const texturePath = isMissing ? '/bingo/not_now.png' : getMutantTexturePath(mutant.specimenId, mutant.skin);
                              const hasSkin = !isMissing && mutant.skin && mutant.skin !== '_any' && mutant.skin.trim() !== '';

                              return (
                                <div class="grid-cell mutant-cell" class:missing-mutant={isMissing} title={getMutantName(mutant.specimenId)} data-specimen-id={!isMissing ? mutant.specimenId : undefined} data-skin={!isMissing ? mutant.skin : undefined}>
                                  <div class="mutant-content">
                                    <img src={textureUrl(texturePath)} alt="" loading="lazy" class="mutant-img" />
                                    {hasSkin && (
                                      <span class="skin-badge" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor" style="display:block">
                                          <path d="M12 0l2.6 9.4L24 12l-9.4 2.6L12 24l-2.6-9.4L0 12l9.4-2.6z" />
                                        </svg>
                                      </span>
                                    )}
                                    <span class="cell-index">{idx + 1}</span>
                                    <div class="cell-check">✓</div>
                                  </div>
                                </div>
                              );
                            })}

                            {hasLineRewards && (
                              <div class="grid-cell reward-cell row-reward" title={getRewardLabel(rowRewards[r], locale, names)}>
                                <div class="reward-content">
                                  <img src={textureUrl(getRewardTexturePath(rowRewards[r]))} alt="" class="reward-img" />
                                  <span class="reward-val">x{rowRewards[r].amount}</span>
                                </div>
                              </div>
                            )}
                          </>
                        ))}

                        {hasLineRewards && (
                          <>
                            {hasHeaders && <div class="grid-cell empty"></div>}
                            {colRewards.map((reward) => (
                              <div class="grid-cell reward-cell col-reward" title={getRewardLabel(reward, locale, names)}>
                                <div class="reward-content">
                                  <img src={textureUrl(getRewardTexturePath(reward))} alt="" class="reward-img" />
                                  <span class="reward-val">x{reward.amount}</span>
                                </div>
                              </div>
                            ))}
                            {completionReward && (
                              <div class="grid-cell reward-cell completion-cell" title={getRewardLabel(completionReward, locale, names)}>
                                <div class="reward-content">
                                  <img src={textureUrl(getRewardTexturePath(completionReward))} alt="" class="reward-img" />
                                  <span class="reward-val main">x{completionReward.amount}</span>
                                  <span class="completion-star" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor" style="display:block">
                                      <path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z" />
                                    </svg>
                                  </span>
                                </div>
                              </div>
                            )}
                          </>
                        )}
                      </div>
                    </div>

                    {(!hasLineRewards || (otherRewards && otherRewards.length > 0)) && (
                       <div class="rewards-fallback">
                         <h3>{t('bingo.rewards', locale)}</h3>
                         <div class="rewards-grid-list">
                           {(hasLineRewards ? otherRewards : bingo.rewards).map((reward) => (
                              <div class="reward-card-simple">
                                 <img src={textureUrl(getRewardTexturePath(reward))} alt="" />
                                 <span>{getRewardLabel(reward, locale, names)}</span>
                              </div>
                           ))}
                         </div>
                       </div>
                    )}
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      );
    })}

    {goldSources.length > 0 && (
      <div class="bingo-panel" data-bingo-index={goldPanelIndex} data-bingo-id={GOLD_TAB_ID} hidden>
        <div class="bingo-card">
          <div class="bingo-card-header">
            <div class="bingo-card-title-wrapper">
              <img class="bingo-header-icon" src={textureUrl('/buildings/gold_furnace_hc2.png')} alt="" />
              <h2 class="bingo-card-title">{t('bingo.cat.gold', locale)}</h2>
            </div>
          </div>
          <p class="gold-intro">{t('bingo.gold.intro', locale)}</p>

          {goldSources.map((src) => (
            <section class="gold-section">
              <div class="gold-section-head">
                <div class="gold-reward">
                  <img src={textureUrl(getRewardTexturePath(src.building))} alt="" class="gold-reward-img" />
                  <span>{getRewardLabel(src.building, locale, names)}</span>
                </div>
                <div class="gold-source">
                  <span class="gold-source-label">{t('bingo.gold.fromBoard', locale)}:</span>
                  <button type="button" class="gold-open-board" data-open-board={src.boardId} title={t('bingo.gold.openBoard', locale)}>
                    <span class={`bingo-header-icon small icon-${src.boardId}`}></span>
                    {src.boardTitle}
                  </button>
                  <span class="gold-scope">
                    {src.headerIcon && <img src={textureUrl(src.headerIcon)} alt="" class="gold-scope-icon" />}
                    {src.scope === 'whole'
                      ? t('bingo.gold.whole', locale)
                      : t(src.scope === 'col' ? 'bingo.gold.column' : 'bingo.gold.row', locale).replace('{n}', String(src.n))}
                  </span>
                </div>
              </div>
              <div class="gold-mutants">
                {src.mutants.map((mutant) => {
                  const hasSkin = mutant.skin && mutant.skin !== '_any' && mutant.skin.trim() !== '';
                  return (
                    <div class="gold-item">
                      <div class="grid-cell mutant-cell" title={getMutantName(mutant.specimenId)} data-specimen-id={mutant.specimenId} data-skin={mutant.skin}>
                        <div class="mutant-content">
                          <img src={textureUrl(getMutantTexturePath(mutant.specimenId, mutant.skin))} alt="" loading="lazy" class="mutant-img" />
                          {hasSkin && (
                            <span class="skin-badge" aria-hidden="true">
                              <svg viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor" style="display:block">
                                <path d="M12 0l2.6 9.4L24 12l-9.4 2.6L12 24l-2.6-9.4L0 12l9.4-2.6z" />
                              </svg>
                            </span>
                          )}
                        </div>
                      </div>
                      <span class="gold-name">{getMutantName(mutant.specimenId)}</span>
                    </div>
                  );
                })}
              </div>
            </section>
          ))}
        </div>
      </div>
    )}
  </div>
  <BingoMutantModal client:load locale={locale} names={names} obtainNames={obtainNames} />
</BaseLayout>

<script define:vars={{ i18nShareCopied, i18nSharePromptLabel }}>
  document.addEventListener("DOMContentLoaded", () => {
    const tabs = document.querySelectorAll(".bingo-tab");
    const selectByIndex = (idx, btn) => {
      document.querySelectorAll(".bingo-panel").forEach(p => p.hidden = true);
      const panel = document.querySelector(`.bingo-panel[data-bingo-index="${idx}"]`);
      if (panel) panel.hidden = false;
      tabs.forEach(t => t.setAttribute("aria-selected", "false"));
      if (btn) btn.setAttribute("aria-selected", "true");
    };
    // Держим URL (?board=<id>) в синхроне с открытой вкладкой, чтобы текущий
    // адрес всегда был готовой ссылкой на конкретное бинго (без лишнего
    // клика "поделиться" - обычный copy-paste адресной строки тоже работает).
    const setBoardParam = (id) => {
      const url = new URL(location.href);
      url.searchParams.set("board", id);
      history.replaceState(null, "", url);
    };

    tabs.forEach(tab => {
      tab.addEventListener("click", (e) => {
        const btn = e.currentTarget;
        selectByIndex(btn.dataset.bingoIndex, btn);
        setBoardParam(btn.dataset.bingoId);
        btn.scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" });
      });
    });

    // Категории-фильтры над вкладками. Скрываем только КНОПКИ вкладок, панели не
    // трогаем: ?board=<id> и скриншот-эндпоинт ищут панель по data-bingo-id и
    // не должны зависеть от выбранной категории.
    const pills = document.querySelectorAll(".bingo-cat-pill");
    const separator = document.querySelector(".bingo-tabs-separator");
    const applyCategory = (cat) => {
      pills.forEach(p => p.setAttribute("aria-pressed", String(p.dataset.category === cat)));
      let firstVisible = null;
      tabs.forEach(tab => {
        const show = cat === "all" || tab.dataset.category === cat;
        tab.hidden = !show;
        if (show && !firstVisible) firstVisible = tab;
      });
      if (separator) separator.hidden = cat !== "all";
      const selected = document.querySelector('.bingo-tab[aria-selected="true"]');
      if ((!selected || selected.hidden) && firstVisible) {
        selectByIndex(firstVisible.dataset.bingoIndex, firstVisible);
        setBoardParam(firstVisible.dataset.bingoId);
      }
      const url = new URL(location.href);
      if (cat === "all") url.searchParams.delete("cat"); else url.searchParams.set("cat", cat);
      history.replaceState(null, "", url);
    };
    pills.forEach(pill => pill.addEventListener("click", () => applyCategory(pill.dataset.category)));

    // "Открыть бинго" в блоке плавильни/кузни: переключаемся в категорию этой доски
    // (иначе её вкладка осталась бы скрытой) и открываем её.
    document.querySelectorAll(".gold-open-board").forEach(btn => {
      btn.addEventListener("click", () => {
        const tab = document.querySelector(`.bingo-tab[data-bingo-id="${btn.dataset.openBoard}"]`);
        if (!tab) return;
        applyCategory(tab.dataset.category);
        selectByIndex(tab.dataset.bingoIndex, tab);
        setBoardParam(tab.dataset.bingoId);
        tab.scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" });
        document.querySelector(".bingo-cats")?.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });

    // ?board=<id> - открыть конкретную доску напрямую (используется скриншот-
    // эндпоинтом api/screenshot-bingo.ts для кросс-поста в Telegram, и теперь
    // и обычными пользовательскими ссылками "поделиться"). ?cat=<категория>
    // восстанавливает фильтр, но только если открытая доска в него входит -
    // иначе остаёмся на "Все", доска никогда не прячется.
    const params = new URLSearchParams(location.search);
    const boardId = params.get("board");
    const catParam = params.get("cat");
    const boardTab = boardId ? document.querySelector(`.bingo-tab[data-bingo-id="${boardId}"]`) : null;
    if (boardTab) selectByIndex(boardTab.dataset.bingoIndex, boardTab);
    if (catParam && catParam !== "all" && document.querySelector(`.bingo-cat-pill[data-category="${catParam}"]`)) {
      if (!boardTab || boardTab.dataset.category === catParam) applyCategory(catParam);
    }

    document.querySelectorAll(".bingo-share-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.dataset.shareBingoId;
        const url = new URL(location.href);
        url.searchParams.set("board", id);
        try {
          await navigator.clipboard.writeText(url.toString());
        } catch {
          window.prompt(i18nSharePromptLabel, url.toString());
          return;
        }
        const label = btn.querySelector(".bingo-share-label");
        if (label) {
          const original = label.textContent;
          label.textContent = i18nShareCopied;
          setTimeout(() => { label.textContent = original; }, 1500);
        }
      });
    });

    // Клик по мутанту в сетке бинго - открыть его модалку (тот же паттерн,
    // что и на странице тир-листа: MutantModal, смонтированная отдельным
    // Svelte-островом, слушает это событие).
    document.querySelectorAll(".mutant-cell[data-specimen-id]").forEach((cell) => {
      cell.addEventListener("click", () => {
        // Поле skin в bingos.json двойное: имя звезды (bronze/silver/gold/platinum),
        // имя скина или "_any" (любая версия). Открываем модалку ровно в том виде,
        // как мутант стоит на доске: звезда -> star, скин -> skin, "_any" -> дефолт.
        const skin = (cell.dataset.skin || "").toLowerCase();
        const detail = { specimenId: cell.dataset.specimenId };
        if (["bronze", "silver", "gold", "platinum"].includes(skin)) detail.star = skin;
        else if (skin && skin !== "_any") detail.skin = skin;
        window.dispatchEvent(new CustomEvent("archivist:open-mutant", { detail }));
      });
    });
  });
</script>

