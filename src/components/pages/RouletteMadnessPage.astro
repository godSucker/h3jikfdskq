---
import BaseLayout from '@/layouts/BaseLayout.astro';
import MutantsMadnessSimulator from '@/components/simulators/madness/MutantsMadnessSimulator.svelte';
import { madnessMachine, getResearchChanceBreakdown } from '@/lib/madness-machine';
import { t, localeFromAstro, translatedHref } from '@/lib/i18n';
import { getLocalizedMutantNames } from '@/lib/mutant-names-i18n';

const locale = localeFromAstro(Astro.currentLocale);

export const prerender = true;

const machine = madnessMachine;
const maxLevel = 200;
const researchChances = getResearchChanceBreakdown(maxLevel, machine);
const jackpotChance = researchChances.find((entry) => entry.key === 'jackpot')?.chance ?? 0;

// Слайс {specimenId: имя} только для мутантов из machine.json, без
// lore/atk-текстов - см. комментарий в MutantsMadnessSimulator.svelte,
// это build-time расчёт (не попадает в клиентский бандл).
const { names: allMutantNames } = getLocalizedMutantNames(locale);
const rewardNames: Record<string, string> = {};
for (const reward of machine.rewards) {
  if (reward.id) {
    const key = reward.id.toLowerCase();
    const name = allMutantNames[key]?.name;
    if (name) rewardNames[key] = name;
  }
}
---
<BaseLayout
  title={t('roulette.madness.pageTitle', locale)}
  description={t('roulette.madness.pageDescription', locale)}
  fullWidth={true}
>
  <div class="back-nav">
    <a href={translatedHref('/simulators/roulette', locale)} class="back-button">
      <span class="icon">←</span>
      <span class="text">{t('roulette.backToRoulettes', locale)}</span>
    </a>
  </div>

  <section class="hero">
    <div class="hero-card">
      <span class="badge">{t('roulette.madness.badge', locale)}</span>
      <h1>Mutants Madness</h1>
      <p>
        {t('roulette.madness.intro', locale)}
      </p>
      <dl class="quick-stats" aria-label={t('roulette.quickStatsAriaLabel', locale)}>
        <div>
          <dt>{t('roulette.madness.statGoldCost', locale)}</dt>
          <dd>{t('roulette.madness.statGoldCostValue', locale).replace('{n}', String(machine.cost))}</dd>
        </div>
        <div>
          <dt>{t('roulette.madness.statTokenCost', locale)}</dt>
          <dd>{t('roulette.madness.statTokenCostValue', locale).replace('{n}', String(machine.tokenCost))}</dd>
        </div>
        <div>
          <dt>{t('roulette.madness.statRewardCount', locale)}</dt>
          <dd>{machine.rewards.length}</dd>
        </div>
        <div>
          <dt>{t('roulette.madness.statJackpotChanceLevel', locale)}</dt>
          <dd>{(jackpotChance * 100).toFixed(4)}%</dd>
        </div>
      </dl>
    </div>
  </section>

  <MutantsMadnessSimulator client:load machine={machine} locale={locale} names={rewardNames} />
</BaseLayout>

<style>
  .hero {
    margin-bottom: 2.6rem;
  }

  .hero-card {
    position: relative;
    padding: 2.9rem;
    border-radius: 40px;
    background: radial-gradient(circle at 20% 20%, rgba(244, 63, 94, 0.25), rgba(15, 23, 42, 0.92));
    border: 1px solid rgba(244, 114, 182, 0.35);
    box-shadow: 0 26px 48px rgba(236, 72, 153, 0.22);
    overflow: hidden;
  }

  .hero-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 80% 0%, rgba(255, 255, 255, 0.12), transparent 55%);
    pointer-events: none;
    mix-blend-mode: screen;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.48rem 1.2rem;
    border-radius: 999px;
    background: rgba(244, 63, 94, 0.2);
    color: #fbcfe8;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 1.1rem 0 0.75rem;
    font-size: 3.1rem;
    color: #ffe4e6;
  }

  p {
    margin: 0;
    max-width: 720px;
    color: rgba(252, 231, 243, 0.82);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .quick-stats {
    margin: 2.2rem 0 0;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
  }

  dt {
    margin: 0 0 0.4rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #e5e7eb;
  }

  dd {
    margin: 0;
    font-size: 1.4rem;
    color: #ffe4e6;
    font-weight: 600;
  }

  .back-nav {
    margin-bottom: 1.5rem;
  }

  .back-button {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 1.2rem;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #e5e7eb;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .back-button:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
    color: #f8fafc;
    transform: translateX(-4px);
  }

  .back-button .icon {
    font-size: 1.1rem;
  }

  @media (max-width: 720px) {
    .hero-card {
      padding: 1.5rem;
      border-radius: 24px;
    }

    h1 {
      font-size: 1.8rem;
    }

    p {
      font-size: 0.95rem;
    }

    .quick-stats {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .back-button {
       width: 100%;
       justify-content: center;
    }
  }
</style>
