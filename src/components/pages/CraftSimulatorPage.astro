---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CraftSimulator from '@/components/simulators/craft/CraftSimulator.svelte';
import { t, localeFromAstro } from '@/lib/i18n';

const locale = localeFromAstro(Astro.currentLocale);

export const prerender = true;
---
<BaseLayout
  title={t('craft.pageTitle', locale)}
  description={t('craft.pageDescription', locale)}
  fullWidth={true}
  viewport="width=device-width, initial-scale=1">
  <CraftSimulator client:load locale={locale} />
</BaseLayout>
