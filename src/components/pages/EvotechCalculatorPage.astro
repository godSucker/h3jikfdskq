---
export const prerender = true;
import BaseLayout from '@/layouts/BaseLayout.astro';
import EvotechCalculator from '@/components/EvotechCalculator.svelte';
import { t, localeFromAstro } from '@/lib/i18n';
import announcements from '@/data/announcements.json';
import mutantsData from '@/data/mutants/mutants.json';
import { getLocalizedMutantNames } from '@/lib/mutant-names-i18n';

const locale = localeFromAstro(Astro.currentLocale);

// Мутанты с повышенной добычей серебра (bank_base от 84): для режима "Тратить или ждать".
// Сектор определяет первый ген. Только build-time, в клиент уходит короткий список.
const { names } = getLocalizedMutantNames(locale);
const moneyMutants = (mutantsData as unknown as { id: string; name: string; bank?: number; genes?: string[] }[])
  .filter((m) => (m.bank ?? 0) >= 84)
  .sort((a, b) => (b.bank ?? 0) - (a.bank ?? 0) || a.name.localeCompare(b.name))
  .map((m) => ({
    id: m.id,
    name: names[m.id]?.name || m.name,
    bank: m.bank as number,
    gene: m.genes?.[0] ?? 'A',
  }));

// Плитка "Скоро в игре" про скидку на эво (баннер Daily_news_tech_V2): единственный
// источник "когда ждать следующую скидку". Даты бывают приблизительными (approx), а
// процент плитка не несёт - он известен только в день старта. Только build-time:
// весь announcements.json в клиентский бандл не попадает, уходит короткий список.
type TechTile = { start: string; end: string | null; approx: boolean };
const seen = new Set<string>();
const techTiles: TechTile[] = [];
for (const a of announcements as unknown as { items?: Record<string, unknown>[] }[]) {
  for (const it of a.items ?? []) {
    if (!/\|Daily_news_tech_V2$/.test(String(it.id)) || !it.exactDateStart) continue;
    const key = String(it.exactDateStart);
    if (seen.has(key)) continue;
    seen.add(key);
    techTiles.push({
      start: key,
      end: it.exactDateEnd ? String(it.exactDateEnd) : null,
      approx: Boolean(it.exactDateApprox),
    });
  }
}
---
<BaseLayout
  title={t('evotech.pageTitle', locale)}
  description={t('evotech.pageDescription', locale)}
>
  <!-- Загрузка Svelte-компонента на клиенте -->
  <EvotechCalculator client:load locale={locale} techTiles={techTiles} moneyMutants={moneyMutants} />
</BaseLayout>
