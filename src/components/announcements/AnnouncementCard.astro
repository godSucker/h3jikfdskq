---
// Тело ОДНОЙ карточки анонса - переиспользуется /announcements (лента,
// mode="feed") и /announcements/render/[id] (изолированная страница для
// скриншот-бота, mode="render"). В режиме "render" CTA-ссылки ("Подробнее",
// "Открыть реактор") не рендерятся вообще - это статичный скриншот, кликать
// там всё равно некуда, а висящая синяя ссылка выглядит как незаконченная
// вёрстка (фидбек 2026-08-07).
import { textureUrl } from '@/lib/texture-cdn'
import { t, pluralizeCount, type Locale } from '@/lib/i18n'
import { resolveMutantLite } from '@/lib/guides-resolve'
import { sprintRangeLabelIn, sprintStartDate, formatDateIn } from '@/lib/sprint-calendar'
import { getRewardTexturePath, getRewardLabel } from '@/lib/bingo-textures'
import {
  categoryLabel,
  cardKind,
  forecastSprint,
  formatBingoTitle,
  bingoAddedNames,
  resolveForecastTarget,
  resolvePackMutants,
  exchangeHallMeta,
  formatPrice,
  exactDateLabelIn,
  boxMutantIcon,
  uniqueBoxMutants,
  boxGroupedOutcomes,
  TIER_ICON,
  fmtDate,
  ribbonLabel,
  ribbonClass,
  featuredMutantLabel,
  type Announcement,
  type AnnouncementRenderContext,
} from '@/lib/announcements-render'

interface Props {
  a: Announcement
  ctx: AnnouncementRenderContext
  mode: 'feed' | 'render'
  // Только для прогноза магазина: 1 или 2 - отрендерить ОДНУ неделю спринта
  // вместо обеих. Нужно скриншот-боту: доска на 38 офферов в один кадр
  // читается плохо, поэтому в админку уходят два снимка по неделе.
  // На живой ленте проп не задаётся - там показываются обе недели подряд.
  week?: 1 | 2 | null
  // Язык карточки. Скриншот-бот всегда снимает русскую версию (см.
  // /announcements/render/[id]), лента - язык текущей страницы.
  locale?: Locale
}

const { a, ctx, mode, week = null, locale = 'ru' } = Astro.props as Props
// id жетона обменника. В записях до 2026-09-18 его нет - достаём из имени
// файла иконки (/materials/Material_Jackpot_Token.png), чтобы и старые
// карточки показывали жетон на языке страницы.
// Вид бокса в данных - русская строка; на /boxes она переводится теми же
// ключами (BoxesPage.astro::categoryLabel).
const boxCategoryLabel = (raw: string) =>
  raw === 'Лаки-бокс'
    ? tr('boxes.category.lucky')
    : raw === 'Мистери-бокс'
      ? tr('boxes.category.mystery')
      : raw

// Подпись записи ребаланса: в данных она русская ("Ребаланс от 18.09.2026:
// 12 мутант(ов)"), а id записи - это дата, и число мутантов лежит отдельным
// полем, так что собираем строку на языке страницы.
const itemLabel = (it2: { id: string; name: string; rebalanceCount?: number }) =>
  a.category === 'rebalance' && it2.rebalanceCount !== undefined
    ? tr('announcements.rebalance.item')
        .replace('{date}', fmtDate(it2.id, locale))
        .replace('{n}', String(it2.rebalanceCount))
        .replace('{word}', pluralizeCount(it2.rebalanceCount, locale))
    : it2.name

const costTokenId = (cost: { id?: string; image?: string | null }) =>
  cost.id ?? cost.image?.split('/').pop()?.replace(/\.[a-z]+$/i, '') ?? ''
const tr = (key: string) => t(key, locale)
// Подпись окна на языке страницы (см. exactDateLabelIn: старые записи без
// ISO-дат падают обратно на русскую строку из данных).
const date = (it2: { exactDateLabel?: string | null } | null | undefined) => exactDateLabelIn(it2, locale)
const kind = cardKind(a.category)
const showCta = mode === 'feed'

const it = a.items?.[0]
const dungeon = kind === 'dungeon' && it ? ctx.dungeonById.get(it.id) : null
const dungeonCover = kind === 'dungeon' && it ? ctx.dungeonCoversMap[it.id] : null
const mutantLite = kind === 'mutant' && it ? resolveMutantLite(it.id, ctx.mutantsById) : null
const skinBaseId = kind === 'skin' && it ? it.id.split('|')[0]?.toLowerCase() : null
// Имя скина в данных записано по-русски ("Шин Хакухо — school"): имя мутанта
// берём на языке страницы, слаг скина оставляем как есть - он и в игре латиницей.
const skinName =
  it && skinBaseId
    ? [ctx.mutantName(skinBaseId), it.name.split('—').slice(1).join('—').trim()]
        .filter(Boolean)
        .join(' — ') || it.name
    : (it?.name ?? '')
const box = kind === 'box' && it ? ctx.findBox(it.id) : null
const boxMutantCount = box ? uniqueBoxMutants(box).length : 0
const boxOutcomes = box ? boxGroupedOutcomes(box) : null
const sprint = kind === 'forecast' && a.items ? forecastSprint(a.items) : null
const questChain = kind === 'quests' && it ? ctx.eventQuestByFilter.get(it.id.toLowerCase()) : null
// Анонс добавленных этапов показывает только линии, где они есть, и
// подсвечивает сами новые этапы; анонс новой цепочки - все линии.
const addedSteps = it?.addedStepIds?.length ? new Set(it.addedStepIds) : null
const questLines = questChain
  ? questChain.lines.filter((line) => !addedSteps || line.some((st) => addedSteps.has(st.id)))
  : []
// Обменники - один Announcement с items из ДО ТРЁХ залов сразу (jackpot/
// event/mystery, см. detectExchange) - группируем по hall в порядке
// EXCHANGE_HALL_META, а не плоским списком (фидбек юзера 2026-09-15).
// Юзер подтвердил (2026-09-16): в джекпот/ивент-зале одновременно актуальны
// только последние 3 позиции, а не все живые слоты разом (их 20+ в
// джекпот-зале) - XML несёт полный пул слотов, но зал "ощущается" игроком
// как ротация тройками. Анализатор тайны - ИСКЛЮЧЕНИЕ (юзер уточнил отдельно
// 2026-09-16): там нет ограничения на 3 активных оффера, cap только на
// jackpot/event. Сортировка по exactDateStart (новые сверху, без даты - в
// конец) - до первого реального прогона с живыми kartel-датами по факту не
// меняет порядок (все null), сработает сама, как только появятся.
const EXCHANGE_HALL_CAP: Record<'jackpot' | 'event' | 'mystery', number | null> = {
  jackpot: 3,
  event: 3,
  mystery: null,
}
const exchangeGroups =
  kind === 'exchange' && a.items
    ? (['jackpot', 'event', 'mystery'] as const)
        .map((hall) => {
          const sorted = a.items!
            .filter((i) => i.hall === hall)
            .sort((x, y) => (y.exactDateStart ?? '').localeCompare(x.exactDateStart ?? ''))
          const cap = EXCHANGE_HALL_CAP[hall]
          return {
            hall,
            meta: exchangeHallMeta(hall, locale),
            items: cap ? sorted.slice(0, cap) : sorted,
          }
        })
        .filter((g) => g.items.length > 0)
    : []
// dailyNews-офферы несут ГОТОВЫЙ игровой баннер (assets/hud/daily_news/ -
// хекс-рамка/название/кнопка уже впаяны в картинку, см. detect-daily-news.ts) -
// рендерим их крупнее и без своей подписи-дубликата под картинкой (board-вид,
// 1-в-1 совпадает с тем, что видно в живой игре). shopForecast-офферы несут
// только голую иконку без рамки - для них подпись/цена/лента нужны.
const isBoard = a.category === 'dailyNews'
const forecastOffers =
  kind === 'forecast' && a.items
    ? a.items
        .filter((o, i, arr) => !o.image || arr.findIndex((x) => x.image === o.image) === i)
        .map((o, i) => ({ o, i }))
        // Хронологически - ближайшие даты сверху, самые дальние снизу.
        // Офферы БЕЗ точной даты (live-данных для них ещё/уже нет) - в самый
        // конец, а не вперемешку (иначе непонятно, почему соседние тайлы
        // "прыгают" без видимой причины).
        //
        // Тай-брейк для пары БЕЗ дат - юзер поймал живьём (2026-09-16,
        // сезон 257 dailyNews, где даты ещё вообще все null): "стабильный"
        // return 0 сохранял сырой порядок офферов из XML/detectDailyNews,
        // а этот сырой порядок УЖЕ идёт "позиция 0 = самая поздняя дата,
        // последняя позиция = самая ранняя" - проверено на реальных датах
        // сезона 256 (18→17→...→6 сентября по позициям 0..22). Значит без
        // резолвнутых дат нужно явно перевернуть исходный порядок (y.i-x.i),
        // не оставлять как есть - иначе для полностью недатированного блока
        // лента идёт задом наперёд относительно реальной хронологии игры.
        .sort((x, y) => {
          const a2 = x.o
          const b2 = y.o
          if (!a2.exactDateStart && !b2.exactDateStart) return y.i - x.i
          if (!a2.exactDateStart) return 1
          if (!b2.exactDateStart) return -1
          return a2.exactDateStart.localeCompare(b2.exactDateStart)
        })
        .map(({ o }) => o)
        // НАЙДЕНО 2026-09-08: старый лимит 18 тихо резал офферы БЕЗ точной
        // даты (см. сортировку выше - они уходят в конец списка), а спринт
        // 256 несёт уже 38 shopForecast-офферов разом (расширение kartel-
        // покрытия + дневные мутанты). Юзер поймал на 2 боксах, у которых
        // фикс "чужой даты" корректно занулил exactDateLabel - без даты они
        // просто улетели за обрез. Грид - auto-fill без фиксированной
        // высоты, оверфлоу не проблема - поднимаем с запасом.
        .slice(0, isBoard ? 24 : 50)
    : []

// Спринт = 14 дней = две недели. Доска на 38 офферов в один кадр читается
// плохо, поэтому режем её на две недели прямо в вёрстке: на ленте видно оба
// блока подряд, а скриншот-бот запрашивает по одной неделе за раз (проп week).
// Граница считается от точного старта спринта, а не от "середины списка" -
// офферы распределены по дням неравномерно.
const WEEK_MS = 7 * 86_400_000
const sprintStartMs = sprint !== null ? sprintStartDate(sprint).getTime() : null
const fmtWeekDay = (ms: number) => formatDateIn(new Date(ms), locale)
const forecastWeeks =
  kind === 'forecast' && sprintStartMs !== null && forecastOffers.length > 0
    ? ([1, 2] as const)
        .map((w) => ({
          week: w,
          // Оффер без точной даты кладём в первую неделю: сортировка уже
          // отправила такие в конец списка, и там они хотя бы не выпадают
          // из кадра совсем.
          offers: forecastOffers.filter((o) => {
            if (!o.exactDateStart) return w === 1
            return (new Date(o.exactDateStart).getTime() - sprintStartMs < WEEK_MS ? 1 : 2) === w
          }),
          label: `${fmtWeekDay(sprintStartMs + (w - 1) * WEEK_MS)} — ${fmtWeekDay(sprintStartMs + w * WEEK_MS - 86_400_000)}`,
        }))
        .filter((g) => g.offers.length > 0 && (week === null || week === g.week))
    : []
---

<article class="card" data-category={a.category ?? ''} data-announcement-id={a.id}>
  {kind === 'quests' && questChain ? (
    <!-- Цепочка ивентовых заданий. Вид повторяет карточку цепочки на /guides
         (таб квестов): номер этапа, условие, награды. Этапы и награды берутся
         при рендере из event-quests.json, в announcements.json - только ссылка. -->
    <div class="quest-card">
      <div class="quest-head">
        {questChain.icon && <img class="quest-icon" src={textureUrl(questChain.icon)} alt="" loading="lazy" decoding="async" />}
        <div class="quest-heading">
          <span class="card-category">{tr(addedSteps ? 'announcements.card.questSteps' : 'announcements.card.quests')}</span>
          <div class="dg-name">{questChain.name}</div>
          <div class="dg-secondary">
            {questChain.stepCount} {pluralizeCount(questChain.stepCount, locale, 'guides.count.stage')}{questChain.requiredLevel
              ? ` · ${tr('guides.quests.fromLevel').replace('{level}', String(questChain.requiredLevel))}`
              : ''}
          </div>
          {date(it) && <div class="dg-exact-date">{date(it)}</div>}
        </div>
      </div>
      <div class="quest-steps">
        {questLines.map((line) => (
          <div class="quest-line">
        {line.map((st, i) => (
          <div class:list={['quest-step', { 'is-new': addedSteps?.has(st.id) }]}>
            <span class="quest-step-index">{i + 1}</span>
            <span class="quest-step-caption">
              {st.condition}
              {st.showAmount && <span class="quest-step-amount">×{st.amountText}</span>}
            </span>
            <span class="quest-step-rewards">
              {st.rewards.map((r) => (
                <span class="quest-reward">
                  {r.icon && <img src={textureUrl(r.icon)} alt="" loading="lazy" decoding="async" />}
                  {r.name ?? r.label}
                  {r.count && <span class="quest-reward-count">{r.count}</span>}
                </span>
              ))}
            </span>
          </div>
        ))}
          </div>
        ))}
      </div>
    </div>
  ) : kind === 'dungeon' && dungeon ? (
    <div class="dg-card">
      <div
        class="dg-hero"
        style={dungeonCover ? `background-image: linear-gradient(180deg, rgba(10,14,22,0.15), rgba(10,14,22,0.8)), url(${dungeonCover})` : undefined}
      >
        {dungeon.mutant && (
          <button class="dg-hero-btn" data-open-mutant={dungeon.mutant.id} title={tr('announcements.open').replace('{name}', dungeon.mutant.name)}>
            <img class="dg-hero-art" src={textureUrl(dungeon.mutant.fullArt)} alt={dungeon.mutant.name} loading="lazy" decoding="async" />
          </button>
        )}
      </div>
      <div class="dg-body">
        <span class="card-category">{categoryLabel(a.category, locale)}</span>
        <div class="dg-name">{dungeon.name}</div>
        {dungeon.mutant ? (
          <button class="dg-mutant-name" data-open-mutant={dungeon.mutant.id}>{dungeon.mutant.name}</button>
        ) : (
          <div class="dg-mutant-name muted">{tr('announcements.dungeon.noMutant')}</div>
        )}
        <div class="dg-secondary">{dungeon.fightCount} {pluralizeCount(dungeon.fightCount, locale, 'announcements.count.fight')}</div>
        {date(it) && <div class="dg-exact-date">{date(it)}</div>}
        {dungeon.currency.length > 0 && (
          <div class="dg-currency">
            {dungeon.currency.map((c) => (
              <span class="reward-inline">
                {c.icon && <img src={textureUrl(c.icon)} alt="" loading="lazy" decoding="async" />}
                {c.label}
              </span>
            ))}
          </div>
        )}
        {dungeon.items.length > 0 && (
          <div class="dg-items">
            {dungeon.items.map((it2) => (
              <span class="dg-item-chip" title={it2.label}>
                {it2.icon && <img src={textureUrl(it2.icon)} alt="" loading="lazy" decoding="async" />}
                <span>{it2.label}</span>
              </span>
            ))}
          </div>
        )}
      </div>
    </div>
  ) : kind === 'mutant' && mutantLite ? (
    <div class="hero-card">
      <button class="hero-art-btn" data-open-mutant={mutantLite.id} title={tr('announcements.open').replace('{name}', mutantLite.name)}>
        <img class="hero-art" src={textureUrl(mutantLite.fullArt)} alt={mutantLite.name} loading="lazy" decoding="async" />
      </button>
      <div class="card-body">
        <time class="card-date" datetime={a.date}>{fmtDate(a.date, locale)}</time>
        <!-- Бейдж говорит о СОБЫТИИ, а не о разделе: "Мутанты" отвечал только на
             "что это за категория", но не на "что произошло" (юзер 2026-09-16).
             Вкладки фильтров вверху ленты остаются во множественном числе -
             там это название раздела. -->
        <span class="card-category">{tr('announcements.card.newMutant')}</span>
        <button class="hero-name-btn" data-open-mutant={mutantLite.id}>{mutantLite.name}</button>
      </div>
    </div>
  ) : kind === 'skin' && it && skinBaseId ? (
    <div class="hero-card">
      <button class="hero-art-btn" data-open-mutant={skinBaseId} title={tr('announcements.open').replace('{name}', skinName)}>
        {it.image && <img class="hero-art" src={textureUrl(it.image)} alt={skinName} loading="lazy" decoding="async" />}
      </button>
      <div class="card-body">
        <time class="card-date" datetime={a.date}>{fmtDate(a.date, locale)}</time>
        <span class="card-category">{tr('announcements.card.newSkin')}</span>
        <button class="hero-name-btn" data-open-mutant={skinBaseId}>{skinName}</button>
      </div>
    </div>
  ) : kind === 'reactor' && it ? (
    <div class="hero-card">
      <a class="hero-art-btn" href={`/simulators/reactor/${it.id}`} title={tr('announcements.openReactor').replace('{name}', it.name)}>
        {it.image && <img class="hero-art" src={textureUrl(it.image)} alt={it.name} loading="lazy" decoding="async" />}
      </a>
      <div class="card-body">
        <time class="card-date" datetime={a.date}>{fmtDate(a.date, locale)}</time>
        <span class="card-category">{categoryLabel('reactor', locale)}</span>
        <a class="hero-name-btn" href={`/simulators/reactor/${it.id}`}>{it.name}</a>
        {showCta && <a class="card-source" href={`/simulators/reactor/${it.id}`}>{tr('announcements.openReactorCta')}</a>}
      </div>
    </div>
  ) : kind === 'box' && it && box && boxOutcomes ? (
    <!-- Некликабельна намеренно (фидбек юзера 2026-09-16) - в отличие от
         тайла прогноза (где видно только название+цена), тут и так весь
         дроп-лист уже развёрнут на карточке, модалка была бы дублем. -->
    <div class="box-drop">
      <div class="box-drop-head">
        {box.icon && <img class="box-drop-icon" src={textureUrl(box.icon)} alt="" loading="lazy" decoding="async" />}
        <div class="box-drop-head-main">
          <div class="box-drop-tags">
            <span class="card-category">{categoryLabel('box', locale)}</span>
            {box.category && <span class="box-drop-subcat">{boxCategoryLabel(box.category)}</span>}
          </div>
          <div class="box-drop-name">{ctx.boxName(box)}</div>
          {formatPrice(box.price, locale) && <div class="box-drop-price">{formatPrice(box.price, locale)}</div>}
          {date(it) && <div class="box-drop-date">{date(it)}</div>}
          {boxMutantCount > 0 && (
            <div class="box-drop-count">
            {tr('announcements.box.dropCount')
              .replace('{n}', String(boxMutantCount))
              .replace('{word}', pluralizeCount(boxMutantCount, locale))}
          </div>
          )}
        </div>
      </div>

      {boxOutcomes.guaranteed.length > 0 && (
        <div class="box-drop-section">
          <div class="box-drop-section-title">{tr('announcements.box.guaranteed')}</div>
          <div class="box-drop-reward-row">
            {boxOutcomes.guaranteed.map((o) => (
              <>
                {o.rewards.map((reward) => {
                  const tex = getRewardTexturePath(reward)
                  return (
                    <span class="box-drop-chip">
                      {tex && <img src={textureUrl(tex)} alt="" loading="lazy" decoding="async" />}
                      {getRewardLabel(reward, locale, ctx.mutantNames)}
                    </span>
                  )
                })}
                {o.mutants.map((m) => (
                  <span class="box-drop-chip">
                    <img src={textureUrl(boxMutantIcon(m))} alt="" loading="lazy" decoding="async" />
                    {ctx.mutantName(m.id) ?? m.name}
                  </span>
                ))}
              </>
            ))}
          </div>
        </div>
      )}

      {boxOutcomes.pool.length > 0 && (
        <div class="box-drop-section">
          {boxOutcomes.guaranteed.length > 0 && <div class="box-drop-section-title">{tr('announcements.box.draw')}</div>}
          <div class:list={['box-drop-grid', { capped: mode === 'feed' }]}>
            {boxOutcomes.pool.map((o) => (
              <div class:list={['box-drop-cell', { multi: o.mutants.length + o.rewards.length > 1 }]}>
                <div class="box-drop-cell-items">
                  {o.mutants.map((m) => (
                    <span class="box-drop-cell-item">
                      <span class="box-drop-cell-img">
                        <img src={textureUrl(boxMutantIcon(m))} alt="" loading="lazy" decoding="async" />
                      </span>
                      <span class="box-drop-cell-name">{ctx.mutantName(m.id) ?? m.name}</span>
                      {m.tier && TIER_ICON[m.tier] && (
                        <img class="box-drop-tier" src={textureUrl(TIER_ICON[m.tier])} alt={m.tier} loading="lazy" decoding="async" />
                      )}
                      {m.skin && <span class="box-drop-skin">{tr('announcements.box.skin').replace('{name}', m.skin)}</span>}
                    </span>
                  ))}
                  {o.rewards.map((reward) => {
                    const tex = getRewardTexturePath(reward)
                    return (
                      <span class="box-drop-cell-item">
                        {tex && <img class="box-drop-cell-reward" src={textureUrl(tex)} alt="" loading="lazy" decoding="async" />}
                        <span class="box-drop-cell-name">{getRewardLabel(reward, locale, ctx.mutantNames)}</span>
                      </span>
                    )
                  })}
                </div>
                <span class="box-drop-chance">{o.chance?.toFixed(1)}%</span>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  ) : kind === 'bingo' && it ? (
    <div class="hero-card">
      <div class="dg-hero bingo-hero">
        <img class="bingo-screenshot" src={`/api/screenshot-bingo?board=${encodeURIComponent(it.id)}`} alt={formatBingoTitle(ctx.bingosById.get(it.id) ?? it.name, it.id, locale)} loading="lazy" decoding="async" />
      </div>
      <div class="card-body">
        <time class="card-date" datetime={a.date}>{fmtDate(a.date, locale)}</time>
        <span class="card-category">{categoryLabel('bingo', locale)}</span>
        <div class="dg-name">{formatBingoTitle(ctx.bingosById.get(it.id) ?? it.name, it.id, locale)}</div>
        {it.addedNames && it.addedNames.length > 0 ? (
          <div class="dg-secondary">{tr('announcements.bingo.added').replace('{names}', bingoAddedNames(it.addedNames, ctx.mutantsById, ctx.localizedMutantName).join(', '))}</div>
        ) : (
          <div class="dg-secondary">{tr('announcements.bingo.new')}</div>
        )}
      </div>
    </div>
  ) : kind === 'exchange' && exchangeGroups.length > 0 ? (
    <div class="exchange-card">
      <span class="card-category">{categoryLabel('exchange', locale)}</span>
      {exchangeGroups.map((group) => (
        <div class="exchange-hall">
          <div class="exchange-hall-head">
            <img class="exchange-hall-icon" src={textureUrl(group.meta.texture)} alt="" loading="lazy" decoding="async" />
            <span class="exchange-hall-title">{group.meta.title}</span>
          </div>
          <div class="exchange-hall-items">
            {group.items.map((gi) => (
              // id = "<hall>|<contractId>|<specimenId>[|stars|skin]" (см.
              // detectExchange) - specimenId всегда 3-й сегмент, во всех 3
              // залах. mystery несёт свою звезду/скин - модалка должна
              // открыться сразу на них, не на дефолтной звезде мутанта.
              <div
                class="exchange-item"
                data-open-mutant={gi.id.split('|')[2]}
                data-open-mutant-star={gi.star ?? undefined}
                data-open-mutant-skin={gi.skin ?? undefined}
              >
                {gi.image && <img class="exchange-item-img" src={textureUrl(gi.image)} alt="" loading="lazy" decoding="async" />}
                <div class="exchange-item-info">
                  <span class="exchange-item-name">
                    {gi.star && (
                      <img
                        class="exchange-item-star"
                        src={textureUrl(`/stars/star_${gi.star}.webp`)}
                        alt=""
                        loading="lazy"
                        decoding="async"
                      />
                    )}
                    {ctx.mutantName(gi.id.split('|')[2] ?? '') ?? gi.name}
                  </span>
                  {gi.cost && (
                    <span class="exchange-item-cost">
                      {gi.cost.image && <img src={textureUrl(gi.cost.image)} alt="" loading="lazy" decoding="async" />}
                      {gi.cost.amount}× {ctx.materialName(costTokenId(gi.cost)) ?? gi.cost.name}
                    </span>
                  )}
                  {date(gi) && <span class="exchange-item-date">{date(gi)}</span>}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  ) : kind === 'forecast' && a.items && a.items.length > 0 ? (
    <div class="forecast-card">
      <div class="forecast-head">
        <span class="card-category">{categoryLabel(a.category, locale)}</span>
      </div>
      {sprint !== null && (
        <div class="forecast-range">{tr('announcements.forecast.season').replace('{n}', String(sprint))} · {sprintRangeLabelIn(sprint, locale)}</div>
      )}
      {forecastWeeks.map((wk) => (
      <div class="forecast-week">
      <div class="forecast-week-head">{tr('announcements.forecast.week').replace('{n}', String(wk.week))} · {wk.label}</div>
      <div class:list={['forecast-grid', { 'forecast-grid-board': isBoard }]}>
        {wk.offers.map((offer) => {
          // Баннер dailyNews несёт название/кнопку УЖЕ впаянными в картинку
          // (реальный игровой ассет) - подпись под ним была бы дублем. Если
          // баннер конкретного оффера не нашёлся (404, редкий старый ивент),
          // показываем текстовую подпись как обычно - иначе тайл окажется пуст.
          const skipCaption = isBoard && !!offer.image
          // exactDateLabel - точный диапазон ЭТОГО оффера (живой kartel-запрос,
          // см. scripts/kartel-filter-dates.ts), не общий диапазон спринта.
          // В board-режиме подпись имени/цены скрыта (баннер сам всё несёт),
          // но точная дата - НОВАЯ информация, которой в баннере нет, поэтому
          // показываем её отдельной строкой, даже когда skipCaption=true.
          const dateLabel = date(offer) ?? (sprint !== null ? sprintRangeLabelIn(sprint, locale) : null)
          // Клик по тайлу прогноза - открыть модалку мутанта/бокса (2026-09-15,
          // фидбек юзера). offer.id - сырой itemId из shopitems.xml, ни mutants.json
          // id, ни boxes.json itemId напрямую не совпадают - resolveForecastTarget
          // разбирает суффикс звезды (specimen_*_Gold и т.п.) или матчит бокс.
          // Бандлы/паки (null) остаются некликабельными - открывать нечего.
          // Только mode="feed" - на статичном render-скриншоте для бота кликать
          // всё равно некуда, курсор-стилизация там будет вводить в заблуждение.
          const target = mode === 'feed' ? resolveForecastTarget(offer.id, ctx.mutantsById, ctx.findBox) : null
          // Имя тайла в данных записано по-русски (из shopitems.xml). Если по
          // itemId удаётся узнать мутанта или бокс - показываем их имя на языке
          // страницы (со звездой, если оффер про неё); бандлы и паки остаются
          // на русском - своего перевода у них нет нигде.
          const named = resolveForecastTarget(offer.id, ctx.mutantsById, ctx.findBox)
          const namedBox = named?.type === 'box' ? ctx.findBox(named.id) : null
          const offerName =
            named?.type === 'mutant'
              ? [ctx.mutantName(named.id), named.star ? `(${tr(`pvp.star.${named.star}`)})` : '']
                  .filter(Boolean)
                  .join(' ')
              : namedBox
                ? ctx.boxName(namedBox)
                : ctx.offerName(offer.id, offer.name)
          // Пакет: мутант лежит не в itemId, а в составе (<ArticleItems>).
          // Один мутант - открываем его сразу, несколько - лист состава.
          const pack =
            mode === 'feed' && !target ? resolvePackMutants(offer.packMutants, ctx.mutantsById) : []
          const packSingle = pack.length === 1 ? pack[0] : null
          const clickable = !!target || pack.length > 0
          return (
            <div
              class:list={['forecast-tile', { 'forecast-tile-board': isBoard, 'forecast-tile-clickable': clickable }]}
              data-open-mutant={target?.type === 'mutant' ? target.id : (packSingle?.id ?? undefined)}
              data-open-mutant-star={target?.type === 'mutant' && target.star ? target.star : (packSingle?.star ?? undefined)}
              data-open-box={target?.type === 'box' ? target.id : undefined}
              data-open-pack={pack.length > 1 ? JSON.stringify(pack) : undefined}
              data-pack-title={pack.length > 1 ? offerName : undefined}
              title={clickable ? tr('announcements.open').replace('{name}', offerName) : undefined}
            >
              <div class="forecast-tile-media">
                {offer.image && <img src={offer.image} alt={offerName} loading="lazy" decoding="async" />}
                {ribbonLabel(offer.ribbon, locale) && (
                  <span class:list={['forecast-ribbon', ribbonClass(offer.ribbon)]}>{ribbonLabel(offer.ribbon, locale)}</span>
                )}
                {featuredMutantLabel(offer.featuredMutant, locale) && (
                  <span class:list={['forecast-featured', `forecast-featured-${offer.featuredMutant}`]}>
                    {featuredMutantLabel(offer.featuredMutant, locale)}
                  </span>
                )}
              </div>
              {!skipCaption && (
                <div class="forecast-tile-info">
                  <span class="forecast-tile-name">{offerName}</span>
                  <span class="forecast-tile-meta">
                    {formatPrice(offer.price, locale) && <span class="forecast-tile-price">{formatPrice(offer.price, locale)}</span>}
                    {dateLabel && <span class="forecast-tile-date">{dateLabel}</span>}
                  </span>
                </div>
              )}
              {skipCaption && date(offer) && (
                <div class="forecast-tile-date-board">{date(offer)}</div>
              )}
            </div>
          )
        })}
      </div>
      </div>
      ))}
      <div class="forecast-watermark">
        <img src="/favicon.png" alt="" loading="lazy" decoding="async" />
        <span>archivist-library.com/announcements</span>
      </div>
    </div>
  ) : (
    <>
      {a.imagePath && (
        <div class="card-image">
          <img src={a.imagePath} alt="" loading="lazy" decoding="async" />
        </div>
      )}
      <div class="card-body">
        <time class="card-date" datetime={a.date}>{fmtDate(a.date, locale)}</time>
        {a.category && <span class="card-category">{categoryLabel(a.category, locale)}</span>}
        {a.title && (
          <h2 class="card-title">
            {a.items?.length === 1 && a.items[0] ? itemLabel(a.items[0]) : a.title}
          </h2>
        )}
        {a.text && <p class="card-text">{a.text}</p>}
        {a.items && a.items.length > 0 && (
          <ul class:list={['item-grid', { 'item-grid-token': a.category === 'token' }]}>
            {a.items.map((it2) => (
              <li class="item-card">
                {it2.image && (
                  <img class="item-image" src={textureUrl(it2.image)} alt={it2.name} loading="lazy" decoding="async" />
                )}
                <span class="item-name">{itemLabel(it2)}</span>
              </li>
            ))}
          </ul>
        )}
        {showCta && a.sourceUrl && (
          <a class="card-source" href={a.sourceUrl} target="_blank" rel="noopener noreferrer">{tr('announcements.source')}</a>
        )}
      </div>
    </>
  )}
</article>

