---
// Тело ОДНОЙ карточки анонса - переиспользуется /announcements (лента,
// mode="feed") и /announcements/render/[id] (изолированная страница для
// скриншот-бота, mode="render"). В режиме "render" CTA-ссылки ("Подробнее",
// "Открыть реактор") не рендерятся вообще - это статичный скриншот, кликать
// там всё равно некуда, а висящая синяя ссылка выглядит как незаконченная
// вёрстка (фидбек 2026-08-07).
import { textureUrl } from '@/lib/texture-cdn'
import { resolveMutantLite } from '@/lib/guides-resolve'
import { sprintRangeLabel } from '@/lib/sprint-calendar'
import { getRewardTexturePath, getRewardLabel } from '@/lib/bingo-textures'
import {
  CATEGORY_RU,
  cardKind,
  forecastSprint,
  formatBingoTitle,
  formatPrice,
  boxMutantIcon,
  uniqueBoxMutants,
  boxGroupedOutcomes,
  TIER_ICON,
  fmtDate,
  ribbonLabel,
  ribbonClass,
  type Announcement,
  type AnnouncementRenderContext,
} from '@/lib/announcements-render'

interface Props {
  a: Announcement
  ctx: AnnouncementRenderContext
  mode: 'feed' | 'render'
}

const { a, ctx, mode } = Astro.props as Props
const kind = cardKind(a.category)
const showCta = mode === 'feed'

const it = a.items?.[0]
const dungeon = kind === 'dungeon' && it ? ctx.dungeonById.get(it.id) : null
const dungeonCover = kind === 'dungeon' && it ? ctx.dungeonCoversMap[it.id] : null
const mutantLite = kind === 'mutant' && it ? resolveMutantLite(it.id, ctx.mutantsById) : null
const skinBaseId = kind === 'skin' && it ? it.id.split('|')[0]?.toLowerCase() : null
const box = kind === 'box' && it ? ctx.findBox(it.id) : null
const boxMutantCount = box ? uniqueBoxMutants(box).length : 0
const boxOutcomes = box ? boxGroupedOutcomes(box) : null
const sprint = kind === 'forecast' && a.items ? forecastSprint(a.items) : null
// dailyNews-офферы несут ГОТОВЫЙ игровой баннер (assets/hud/daily_news/ -
// хекс-рамка/название/кнопка уже впаяны в картинку, см. detect-daily-news.ts) -
// рендерим их крупнее и без своей подписи-дубликата под картинкой (board-вид,
// 1-в-1 совпадает с тем, что видно в живой игре). shopForecast-офферы несут
// только голую иконку без рамки - для них подпись/цена/лента нужны.
const isBoard = a.category === 'dailyNews'
const forecastOffers =
  kind === 'forecast' && a.items
    ? a.items
        .filter((o, i, arr) => !o.image || arr.findIndex((x) => x.image === o.image) === i)
        // Хронологически - ближайшие даты сверху, самые дальние снизу.
        // Офферы БЕЗ точной даты (live-данных для них ещё/уже нет) - в самый
        // конец, а не вперемешку (иначе непонятно, почему соседние тайлы
        // "прыгают" без видимой причины).
        .sort((a2, b2) => {
          if (!a2.exactDateStart && !b2.exactDateStart) return 0
          if (!a2.exactDateStart) return 1
          if (!b2.exactDateStart) return -1
          return a2.exactDateStart.localeCompare(b2.exactDateStart)
        })
        .slice(0, isBoard ? 24 : 18)
    : []
---

<article class="card" data-category={a.category ?? ''} data-announcement-id={a.id}>
  {kind === 'dungeon' && dungeon ? (
    <div class="dg-card">
      <div
        class="dg-hero"
        style={dungeonCover ? `background-image: linear-gradient(180deg, rgba(10,14,22,0.15), rgba(10,14,22,0.8)), url(${dungeonCover})` : undefined}
      >
        {dungeon.mutant && (
          <button class="dg-hero-btn" data-open-mutant={dungeon.mutant.id} title={`Открыть ${dungeon.mutant.name}`}>
            <img class="dg-hero-art" src={textureUrl(dungeon.mutant.fullArt)} alt={dungeon.mutant.name} loading="lazy" decoding="async" />
          </button>
        )}
      </div>
      <div class="dg-body">
        <span class="card-category">{CATEGORY_RU[a.category ?? ''] ?? a.category}</span>
        <div class="dg-name">{dungeon.name}</div>
        {dungeon.mutant ? (
          <button class="dg-mutant-name" data-open-mutant={dungeon.mutant.id}>{dungeon.mutant.name}</button>
        ) : (
          <div class="dg-mutant-name muted">без уникального мутанта</div>
        )}
        <div class="dg-secondary">{dungeon.fightCount} боёв</div>
        {it?.exactDateLabel && <div class="dg-exact-date">{it.exactDateLabel}</div>}
        {dungeon.currency.length > 0 && (
          <div class="dg-currency">
            {dungeon.currency.map((c) => (
              <span class="reward-inline">
                {c.icon && <img src={textureUrl(c.icon)} alt="" loading="lazy" decoding="async" />}
                {c.label}
              </span>
            ))}
          </div>
        )}
        {dungeon.items.length > 0 && (
          <div class="dg-items">
            {dungeon.items.map((it2) => (
              <span class="dg-item-chip" title={it2.label}>
                {it2.icon && <img src={textureUrl(it2.icon)} alt="" loading="lazy" decoding="async" />}
                <span>{it2.label}</span>
              </span>
            ))}
          </div>
        )}
        {showCta && <a class="card-source" href={a.link ?? '/guides'}>Подробнее →</a>}
      </div>
    </div>
  ) : kind === 'mutant' && mutantLite ? (
    <div class="hero-card">
      <button class="hero-art-btn" data-open-mutant={mutantLite.id} title={`Открыть ${mutantLite.name}`}>
        <img class="hero-art" src={textureUrl(mutantLite.fullArt)} alt={mutantLite.name} loading="lazy" decoding="async" />
      </button>
      <div class="card-body">
        <time class="card-date" datetime={a.date}>{fmtDate(a.date)}</time>
        <span class="card-category">{CATEGORY_RU.mutant}</span>
        <button class="hero-name-btn" data-open-mutant={mutantLite.id}>{mutantLite.name}</button>
        {showCta && <a class="card-source" href={a.link ?? '/mutants'}>Подробнее →</a>}
      </div>
    </div>
  ) : kind === 'skin' && it && skinBaseId ? (
    <div class="hero-card">
      <button class="hero-art-btn" data-open-mutant={skinBaseId} title={`Открыть ${it.name}`}>
        {it.image && <img class="hero-art" src={textureUrl(it.image)} alt={it.name} loading="lazy" decoding="async" />}
      </button>
      <div class="card-body">
        <time class="card-date" datetime={a.date}>{fmtDate(a.date)}</time>
        <span class="card-category">{CATEGORY_RU.skin}</span>
        <button class="hero-name-btn" data-open-mutant={skinBaseId}>{it.name}</button>
        {showCta && <a class="card-source" href={a.link ?? '/mutants'}>Подробнее →</a>}
      </div>
    </div>
  ) : kind === 'reactor' && it ? (
    <div class="hero-card">
      <a class="hero-art-btn" href={`/simulators/reactor/${it.id}`} title={`Открыть реактор «${it.name}»`}>
        {it.image && <img class="hero-art" src={textureUrl(it.image)} alt={it.name} loading="lazy" decoding="async" />}
      </a>
      <div class="card-body">
        <time class="card-date" datetime={a.date}>{fmtDate(a.date)}</time>
        <span class="card-category">{CATEGORY_RU.reactor}</span>
        <a class="hero-name-btn" href={`/simulators/reactor/${it.id}`}>{it.name}</a>
        {showCta && <a class="card-source" href={`/simulators/reactor/${it.id}`}>Открыть реактор →</a>}
      </div>
    </div>
  ) : kind === 'box' && it && box && boxOutcomes ? (
    <div class="box-drop" data-open-box={box.itemId} title={`Открыть ${box.name}`}>
      <div class="box-drop-head">
        {box.icon && <img class="box-drop-icon" src={textureUrl(box.icon)} alt="" loading="lazy" decoding="async" />}
        <div class="box-drop-head-main">
          <div class="box-drop-tags">
            <span class="card-category">{CATEGORY_RU.box}</span>
            {box.category && <span class="box-drop-subcat">{box.category}</span>}
          </div>
          <div class="box-drop-name">{box.name}</div>
          {formatPrice(box.price) && <div class="box-drop-price">{formatPrice(box.price)}</div>}
          {it.exactDateLabel && <div class="box-drop-date">{it.exactDateLabel}</div>}
          {boxMutantCount > 0 && (
            <div class="box-drop-count">{boxMutantCount} мутант(ов) в дроп-листе</div>
          )}
        </div>
      </div>

      {boxOutcomes.guaranteed.length > 0 && (
        <div class="box-drop-section">
          <div class="box-drop-section-title">Гарантированно</div>
          <div class="box-drop-reward-row">
            {boxOutcomes.guaranteed.map((o) => (
              <>
                {o.rewards.map((reward) => {
                  const tex = getRewardTexturePath(reward)
                  return (
                    <span class="box-drop-chip">
                      {tex && <img src={textureUrl(tex)} alt="" loading="lazy" decoding="async" />}
                      {getRewardLabel(reward)}
                    </span>
                  )
                })}
                {o.mutants.map((m) => (
                  <span class="box-drop-chip">
                    <img src={textureUrl(boxMutantIcon(m))} alt="" loading="lazy" decoding="async" />
                    {m.name}
                  </span>
                ))}
              </>
            ))}
          </div>
        </div>
      )}

      {boxOutcomes.pool.length > 0 && (
        <div class="box-drop-section">
          {boxOutcomes.guaranteed.length > 0 && <div class="box-drop-section-title">Розыгрыш</div>}
          <div class:list={['box-drop-grid', { capped: mode === 'feed' }]}>
            {boxOutcomes.pool.map((o) => (
              <div class:list={['box-drop-cell', { multi: o.mutants.length + o.rewards.length > 1 }]}>
                <div class="box-drop-cell-items">
                  {o.mutants.map((m) => (
                    <span class="box-drop-cell-item">
                      <span class="box-drop-cell-img">
                        <img src={textureUrl(boxMutantIcon(m))} alt="" loading="lazy" decoding="async" />
                      </span>
                      <span class="box-drop-cell-name">{m.name}</span>
                      {m.tier && TIER_ICON[m.tier] && (
                        <img class="box-drop-tier" src={textureUrl(TIER_ICON[m.tier])} alt={m.tier} loading="lazy" decoding="async" />
                      )}
                      {m.skin && <span class="box-drop-skin">скин: {m.skin}</span>}
                    </span>
                  ))}
                  {o.rewards.map((reward) => {
                    const tex = getRewardTexturePath(reward)
                    return (
                      <span class="box-drop-cell-item">
                        {tex && <img class="box-drop-cell-reward" src={textureUrl(tex)} alt="" loading="lazy" decoding="async" />}
                        <span class="box-drop-cell-name">{getRewardLabel(reward)}</span>
                      </span>
                    )
                  })}
                </div>
                <span class="box-drop-chance">{o.chance?.toFixed(1)}%</span>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  ) : kind === 'bingo' && it ? (
    <div class="hero-card">
      <div class="dg-hero bingo-hero">
        <img class="bingo-screenshot" src={`/api/screenshot-bingo?board=${encodeURIComponent(it.id)}`} alt={formatBingoTitle(ctx.bingosById.get(it.id) ?? it.name, it.id)} loading="lazy" decoding="async" />
      </div>
      <div class="card-body">
        <time class="card-date" datetime={a.date}>{fmtDate(a.date)}</time>
        <span class="card-category">{CATEGORY_RU.bingo}</span>
        <div class="dg-name">{formatBingoTitle(ctx.bingosById.get(it.id) ?? it.name, it.id)}</div>
        {it.addedNames && it.addedNames.length > 0 ? (
          <div class="dg-secondary">Добавлен{it.addedNames.length > 1 ? 'ы' : ''}: {it.addedNames.join(', ')}</div>
        ) : (
          <div class="dg-secondary">Новое бинго</div>
        )}
        {showCta && <a class="card-source" href={a.link ?? '/bingo'}>Подробнее →</a>}
      </div>
    </div>
  ) : kind === 'forecast' && a.items && a.items.length > 0 ? (
    <div class="forecast-card">
      <div class="forecast-head">
        <span class="card-category">{CATEGORY_RU[a.category ?? ''] ?? a.category}</span>
      </div>
      {sprint !== null && (
        <div class="forecast-range">Сезон {sprint} · {sprintRangeLabel(sprint)}</div>
      )}
      <div class:list={['forecast-grid', { 'forecast-grid-board': isBoard }]}>
        {forecastOffers.map((offer) => {
          // Баннер dailyNews несёт название/кнопку УЖЕ впаянными в картинку
          // (реальный игровой ассет) - подпись под ним была бы дублем. Если
          // баннер конкретного оффера не нашёлся (404, редкий старый ивент),
          // показываем текстовую подпись как обычно - иначе тайл окажется пуст.
          const skipCaption = isBoard && !!offer.image
          // exactDateLabel - точный диапазон ЭТОГО оффера (живой kartel-запрос,
          // см. scripts/kartel-filter-dates.ts), не общий диапазон спринта.
          // В board-режиме подпись имени/цены скрыта (баннер сам всё несёт),
          // но точная дата - НОВАЯ информация, которой в баннере нет, поэтому
          // показываем её отдельной строкой, даже когда skipCaption=true.
          const dateLabel = offer.exactDateLabel ?? (sprint !== null ? sprintRangeLabel(sprint) : null)
          return (
            <div class:list={['forecast-tile', { 'forecast-tile-board': isBoard }]}>
              <div class="forecast-tile-media">
                {offer.image && <img src={offer.image} alt={offer.name} loading="lazy" decoding="async" />}
                {ribbonLabel(offer.ribbon) && (
                  <span class:list={['forecast-ribbon', ribbonClass(offer.ribbon)]}>{ribbonLabel(offer.ribbon)}</span>
                )}
              </div>
              {!skipCaption && (
                <div class="forecast-tile-info">
                  <span class="forecast-tile-name">{offer.name}</span>
                  <span class="forecast-tile-meta">
                    {formatPrice(offer.price) && <span class="forecast-tile-price">{formatPrice(offer.price)}</span>}
                    {dateLabel && <span class="forecast-tile-date">{dateLabel}</span>}
                  </span>
                </div>
              )}
              {skipCaption && offer.exactDateLabel && (
                <div class="forecast-tile-date-board">{offer.exactDateLabel}</div>
              )}
            </div>
          )
        })}
      </div>
      <div class="forecast-watermark">
        <img src="/favicon.png" alt="" loading="lazy" decoding="async" />
        <span>archivist-library.com/announcements</span>
      </div>
    </div>
  ) : (
    <>
      {a.imagePath && (
        <div class="card-image">
          <img src={a.imagePath} alt="" loading="lazy" decoding="async" />
        </div>
      )}
      <div class="card-body">
        <time class="card-date" datetime={a.date}>{fmtDate(a.date)}</time>
        {a.category && <span class="card-category">{CATEGORY_RU[a.category] ?? a.category}</span>}
        {a.title && <h2 class="card-title">{a.title}</h2>}
        {a.text && <p class="card-text">{a.text}</p>}
        {a.items && a.items.length > 0 && (
          <ul class:list={['item-grid', { 'item-grid-token': a.category === 'token' }]}>
            {a.items.map((it2) => (
              <li class="item-card">
                {it2.image && (
                  <img class="item-image" src={textureUrl(it2.image)} alt={it2.name} loading="lazy" decoding="async" />
                )}
                <span class="item-name">{it2.name}</span>
              </li>
            ))}
          </ul>
        )}
        {showCta && a.link && (
          <a class="card-source" href={a.link}>Подробнее →</a>
        )}
        {showCta && a.sourceUrl && (
          <a class="card-source" href={a.sourceUrl} target="_blank" rel="noopener noreferrer">Источник →</a>
        )}
      </div>
    </>
  )}
</article>

<style>
  .card {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    overflow: hidden;
  }
  .card-image {
    width: 100%;
    max-height: 420px;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.3);
  }
  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .card-body {
    padding: 1rem 1.1rem 1.2rem;
  }
  /* Только для типов БЕЗ собственной реальной даты (мутанты/скины/реакторы/
     бинго/обменники/жетоны/ребаланс) - "когда наш бот это заметил", не дата
     события в игре. У рейдов/лесенок/боксов/прогноза магазина теперь есть
     настоящий exactDateLabel/sprintRangeLabel - там эта плашка убрана
     совсем (была бы двусмысленной, читалась как игровая дата). */
  .card-date {
    display: inline-block;
    margin-right: 0.5rem;
    margin-bottom: 0.6rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: rgb(96, 165, 250);
    background: rgba(96, 165, 250, 0.12);
    border: 1px solid rgba(96, 165, 250, 0.35);
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
  }
  .card-category {
    display: inline-block;
    margin-bottom: 0.6rem;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: rgb(250, 204, 21);
    background: rgba(250, 204, 21, 0.12);
    border: 1px solid rgba(250, 204, 21, 0.35);
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
  }
  .card-title {
    margin: 0.6rem 0 0.3rem;
    font-size: 1.15rem;
    color: #fceabb;
  }
  .card-text {
    color: #e2e8f0;
    line-height: 1.6;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .item-grid {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0.7rem 0;
    padding: 0;
  }
  .item-card {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(30, 41, 59, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 0.4rem 0.7rem 0.4rem 0.4rem;
  }
  .item-image {
    width: 36px;
    height: 36px;
    object-fit: contain;
    border-radius: 6px;
    background: rgba(0, 0, 0, 0.3);
  }
  .item-grid-token .item-image {
    width: 56px;
    height: 56px;
  }
  .item-grid-token .item-card {
    padding: 0.5rem 0.9rem 0.5rem 0.5rem;
  }
  .item-name {
    font-size: 0.85rem;
    color: #e2e8f0;
  }
  .card-source {
    display: inline-block;
    margin-top: 0.7rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: rgb(96, 165, 250);
    text-decoration: none;
  }
  .card-source:hover {
    text-decoration: underline;
  }

  /* Рейды/лесенки - тот же визуальный язык, что activityCard на /guides */
  .dg-hero {
    position: relative;
    height: 180px;
    background: radial-gradient(circle at 50% 30%, rgba(96, 165, 250, 0.16), transparent 70%);
    background-size: cover;
    background-position: center;
    overflow: hidden;
  }
  .dg-hero-btn {
    appearance: none;
    border: none;
    padding: 0;
    cursor: pointer;
    display: block;
    width: 100%;
    height: 100%;
    background: none;
  }
  .dg-hero-art {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
    filter: drop-shadow(0 6px 10px rgba(0, 0, 0, 0.5));
  }
  .dg-body {
    padding: 1rem 1.1rem 1.2rem;
  }
  .dg-name {
    margin-top: 0.4rem;
    font-size: 1.1rem;
    font-weight: 800;
    color: #fceabb;
  }
  .dg-mutant-name {
    appearance: none;
    background: none;
    border: none;
    padding: 0;
    text-align: left;
    font-size: 0.95rem;
    font-weight: 800;
    color: #e2e8f0;
    cursor: pointer;
    display: block;
    margin-top: 0.15rem;
  }
  .dg-mutant-name:hover {
    color: #60a5fa;
  }
  .dg-mutant-name.muted {
    color: #64748b;
    font-weight: 600;
    font-size: 0.85rem;
    cursor: default;
  }
  .dg-secondary {
    font-size: 0.78rem;
    color: #64748b;
    margin-top: 0.25rem;
  }
  /* Точная дата запуска - живой kartel-запрос (см. scripts/kartel-filter-dates.ts),
     не диапазон спринта - у рейдов/лесенок его и не было отродясь. */
  .dg-exact-date {
    font-size: 0.76rem;
    font-weight: 600;
    color: rgb(96, 165, 250);
    margin-top: 0.15rem;
  }
  .dg-currency {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin-top: 0.5rem;
  }
  .reward-inline {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.8rem;
    color: #86efac;
  }
  .reward-inline img {
    width: 16px;
    height: 16px;
    object-fit: contain;
  }
  .dg-items {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 0.4rem;
  }
  .dg-item-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: rgba(30, 41, 59, 0.6);
    border-radius: 8px;
    padding: 0.2rem 0.5rem;
    font-size: 0.76rem;
    color: #cbd5f5;
    max-width: 13.75rem;
  }
