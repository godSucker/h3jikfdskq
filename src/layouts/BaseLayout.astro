---
/* eslint-disable astro/no-unused-css-selector -- .menu-toggle.active вешается из JS (classList) */
import "@/styles/global.css";
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from "@vercel/speed-insights/astro"
import SearchBox from '@/components/search/SearchBox.svelte';
import { TRANSLATED_UI_LOCALES, TRANSLATED_PATHS, localeFromAstro, localePrefix, t, type Locale } from '@/lib/i18n';
// Simple base layout for the site.
// It provides a consistent header, footer and sets a dark theme background.
const {
  title,
  description,
  canonical,
  fullWidth = false,
  viewport = "width=device-width, initial-scale=1",
} = Astro.props;

const locale = localeFromAstro(Astro.currentLocale);
const OG_LOCALE_MAP: Partial<Record<Locale, string>> = { ru: 'ru_RU', en: 'en_US', es: 'es_ES', fr: 'fr_FR' };

// hreflang только для реально переведённых страниц и локалей с авторским
// UI-словарём (Батч 11 (2), TRANSLATED_PATHS/TRANSLATED_UI_LOCALES в i18n.ts) -
// de/pt/it/tr/nl страницы существуют (EN-фолбэк), но пока не рекламируются
// поисковикам/переключателем как отдельный язык.
const pathWithoutLocale = Astro.url.pathname.replace(new RegExp(`^${localePrefix(locale)}`), '') || '/';
const isPilotPage = (TRANSLATED_PATHS as readonly string[]).includes(pathWithoutLocale);

// SEO: ключевые слова MGG / Mutants Genetic Gladiators присутствуют в
// дефолтном заголовке и описании каждой страницы.
const SITE_NAME = t('site.name', locale);
const pageTitle = title ? `${title} | Archivist-Library (MGG)` : SITE_NAME;
const pageDescription = description ?? t('site.description', locale);
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, 'https://archivist-library.com').href;
const isHome = Astro.url.pathname === "/";

// SEO: structured data (schema.org). WebSite описывает сайт как единую сущность -
// помогает Google связать бренд-запрос ("archivist-library") именно с этим доменом,
// а не потеряться среди похожих названий. Organization даёт то же самое для карточки
// бренда в поиске. Отдаём на каждой странице (не только на главной) - не мешает,
// а лишний сигнал сущности с любой проиндексированной страницы не помешает.
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Archivist-Library',
    alternateName: 'MGG Hub',
    url: 'https://archivist-library.com/',
    description: t('site.description', locale),
    inLanguage: locale,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Archivist-Library',
    url: 'https://archivist-library.com/',
    logo: 'https://archivist-library.com/favicon.png',
  },
];
---

<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content={viewport} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <!-- Open Graph: карточка страницы в соцсетях/мессенджерах -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Archivist-Library" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://archivist-library.com/preview.jpg" />
    <meta property="og:locale" content={OG_LOCALE_MAP[locale]} />
    {isPilotPage && TRANSLATED_UI_LOCALES.filter((l) => l !== locale).map((l) => (
      <meta property="og:locale:alternate" content={OG_LOCALE_MAP[l]} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" as="font" type="font/woff2" href="https://cdn.archivist-library.com/fonts/tt-supermolot-neue/TTSupermolotNeue-Bold.woff2" crossorigin>
    <link rel="stylesheet" href="https://cdn.archivist-library.com/fonts/tt-supermolot-neue/tt-supermolot-neue.css">
    <!-- Каноническая ссылка (говорит ботам, что это главная версия страницы) -->
    <link rel="canonical" href={canonicalUrl} />
    <!-- hreflang: только на реально переведённых страницах пилота (Батч 11) -->
    {isPilotPage && TRANSLATED_UI_LOCALES.map((l) => (
      <link rel="alternate" hreflang={l} href={`https://archivist-library.com${localePrefix(l)}${pathWithoutLocale === '/' ? '' : pathWithoutLocale}`} />
    ))}
    {isPilotPage && (
      <link rel="alternate" hreflang="x-default" href={`https://archivist-library.com${pathWithoutLocale === '/' ? '' : pathWithoutLocale}`} />
    )}
    <!-- Иконка вкладки браузера -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <!-- Structured data (schema.org): помогает поисковикам распознать бренд/сайт -->
    {structuredData.map((entry) => (
      // eslint-disable-next-line astro/no-set-html-directive -- статичный JSON.stringify нашего же объекта, не пользовательский ввод
      <script type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}
    <style>
      body {
        margin: 0;
        font-family: "TT Supermolot Neue", ui-sans-serif, system-ui, -apple-system,
                 "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans",
                 "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji";
        font-weight: 700;
        font-style: normal;
        background-color: #0d1117;
        color: #c9d1d9;
        min-height: 100vh;
        position: relative;
        display: flex;
        flex-direction: column;
        overflow-x: hidden;
      }

      body::before {
        content: "";
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: url('https://cdn.archivist-library.com/main_page.webp');
        background-size: cover;
        background-position: center center;
        background-repeat: no-repeat;
        z-index: -1;
        opacity: 0.35;
        filter: saturate(1.4) brightness(0.5) contrast(1.1) blur(10px);
        transform: scale(1.05);
      }

      @supports not (background-image: url('data:image/webp;base64,')) {
        body::before {
          background-image: url('https://cdn.archivist-library.com/main_page.jpg');
        }
      }

      @media (max-width: 767px) {
        body::before {
          background-size: cover;
          background-position: center center;
          background-repeat: no-repeat;
          background-attachment: fixed;
          opacity: 0.35;
        }
      }
      
      /* Header styles */
      header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.75rem 1rem;
        background-color: rgba(22, 27, 34, 0.8);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid rgba(48, 54, 61, 0.5);
        position: sticky;
        top: -1px; /* Lift up by 1px to close the gap */
        z-index: 100;
      }
      
      header .logo {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }
      header .logo a {
        color: #58a6ff;
        text-decoration: none;
        font-size: 1.25rem;
        white-space: nowrap;
      }

      .global-back-button {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: rgba(88, 166, 255, 0.1);
        border: 1px solid rgba(88, 166, 255, 0.2);
        color: #58a6ff;
        text-decoration: none;
        transition: all 0.2s ease;
        margin-right: 0.5rem;
      }

      .global-back-button:hover {
        background: rgba(88, 166, 255, 0.2);
        transform: translateX(-2px);
      }
      
      /* Языковой переключатель (i18n-пилот, Батч 11) */
      .lang-switcher {
        display: flex;
        gap: 2px;
        flex-shrink: 0;
      }

      .lang-switcher a {
        color: #8b949e;
        text-decoration: none;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 0.35rem 0.45rem;
        border-radius: 6px;
        transition: all 0.2s;
      }

      .lang-switcher a:hover {
        background-color: rgba(88, 166, 255, 0.1);
        color: #79c0ff;
      }

      .lang-switcher a.active {
        color: #58a6ff;
        background-color: rgba(88, 166, 255, 0.15);
      }

      /* Hamburger menu button */
      .menu-toggle {
        display: none;
        flex-direction: column;
        gap: 4px;
        background: none;
        border: none;
        cursor: pointer;
        padding: 8px;
      }
      
      .menu-toggle span {
        display: block;
        width: 24px;
        height: 3px;
        background-color: #c9d1d9;
        transition: all 0.3s ease;
        border-radius: 2px;
      }
      
      .menu-toggle.active span:nth-child(1) {
        transform: rotate(45deg) translate(6px, 6px);
      }
      
      .menu-toggle.active span:nth-child(2) {
        opacity: 0;
      }
      
      .menu-toggle.active span:nth-child(3) {
        transform: rotate(-45deg) translate(6px, -6px);
      }
      
      /* Desktop navigation */
      header nav {
        display: flex;
        gap: 0.25rem;
        align-items: center;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
      }

      header nav::-webkit-scrollbar {
        display: none;
      }
      
      header nav a {
        color: #58a6ff;
        text-decoration: none;
        font-size: 0.78rem;
        white-space: nowrap;
        flex-shrink: 0;
        transition: all 0.2s;
        padding: 0.5rem 0.55rem;
        border-radius: 6px;
      }
      
      header nav a:hover {
        background-color: rgba(88, 166, 255, 0.1);
        color: #79c0ff;
      }

      /* Dropdown styles */
      .dropdown {
        position: relative;
        display: inline-block;
        flex-shrink: 0;
      }

      .dropdown-trigger {
        color: #58a6ff;
        text-decoration: none;
        font-size: 0.9rem;
        white-space: nowrap;
        transition: all 0.2s;
        padding: 0.5rem 0.75rem;
        border-radius: 6px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 4px;
        background: none;
        border: none;
        font-family: inherit;
        font-weight: 700;
      }

      .dropdown:hover .dropdown-trigger {
        background-color: rgba(88, 166, 255, 0.1);
        color: #79c0ff;
      }

      .dropdown-menu {
        position: absolute;
        top: 100%;
        left: 50%;
        transform: translateX(-50%) translateY(10px);
        background-color: rgba(22, 27, 34, 0.95);
        backdrop-filter: blur(12px);
        border: 1px solid #30363d;
        border-radius: 12px;
        min-width: 200px;
        padding: 0.5rem;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        z-index: 100;
      }

      .dropdown:hover .dropdown-menu {
        opacity: 1;
        visibility: visible;
        transform: translateX(-50%) translateY(5px);
      }

      .dropdown-menu a {
        display: flex;
        align-items: center;
        padding: 0.75rem 1rem;
        color: #c9d1d9;
        font-size: 0.85rem;
        border-radius: 8px;
        transition: all 0.2s;
      }

      .dropdown-menu a:hover {
        background: linear-gradient(90deg, rgba(88, 166, 255, 0.15) 0%, transparent 100%);
        color: #58a6ff;
        text-decoration: none;
        transform: translateX(5px);
      }

      .dropdown-trigger::after {
        content: '▾';
        font-size: 0.8rem;
        transition: transform 0.2s;
      }

      .dropdown:hover .dropdown-trigger::after {
        transform: rotate(180deg);
      }
      
      /* Mobile navigation */
      .mobile-nav {
        display: none;
        position: fixed;
        top: 0;
        right: -100%;
        width: 280px;
        height: 100vh;
        height: 100dvh;
        background-color: #161b22;
        border-left: 1px solid #30363d;
        padding: 1rem;
        z-index: 1000;
        transition: right 0.3s ease;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        overscroll-behavior: contain;
      }
      
      .mobile-nav.active {
        right: 0;
      }
      
      .mobile-nav-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #30363d;
      }
      
      .mobile-nav-header h2 {
        color: #c9d1d9;
        font-size: 1.25rem;
        margin: 0;
      }
      
      .close-btn {
        background: none;
        border: none;
        color: #c9d1d9;
        font-size: 1.5rem;
        cursor: pointer;
        padding: 0;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      
      .mobile-nav a {
        display: block;
        color: #58a6ff;
        text-decoration: none;
        padding: 0.875rem 0;
        font-size: 1rem;
        border-bottom: 1px solid #21262d;
        transition: color 0.2s;
      }
      
      .mobile-nav a:hover {
        color: #79c0ff;
      }
      
      /* Overlay */
      .overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.7);
        z-index: 999;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
      }
      
      .overlay.active {
        opacity: 1;
        pointer-events: auto;
      }
      
      /* Main content */
      main {
        flex: 1 0 auto; /* Позволяет контенту расти и толкать футер */
        padding: 1rem;
        max-width: 1440px;
        width: 100%;
        margin: 0 auto;
        box-sizing: border-box;
      }

      main.wide {
        max-width: 1920px;
      }
      
      /* 2K / 4K Upscaling & Layout adjustments */
      @media (min-width: 1921px) {
        html {
          font-size: 140%; /* Существенное увеличение масштаба для 2K */
        }
        main {
          max-width: 1800px;
          padding: 2rem;
        }
        main.wide {
          max-width: 2560px;
        }
      }

      @media (min-width: 3840px) {
        html {
          font-size: 170%; /* Глобальное увеличение масштаба для 4K */
        }
        main {
          max-width: 2800px;
        }
        main.wide {
          max-width: 3600px;
        }
      }

      /* Footer */
      footer {
        flex-shrink: 0; /* Футер не сжимается */
        margin-top: 4rem;
        padding: 3rem 1rem;
        background-color: rgba(22, 27, 34, 0.8);
        backdrop-filter: blur(8px);
        border-top: 1px solid rgba(48, 54, 61, 0.5);
        text-align: center;
        color: #7d8590;
        font-size: 0.9rem;
      }
      
      /* Mobile styles */
      @media (max-width: 767px) {
        .menu-toggle {
          display: flex;
        }

        header nav {
          display: none;
        }

        .mobile-nav {
          display: block;
        }

        .overlay {
          display: block;
        }

        main {
          padding: 0.75rem 0.5rem;
        }

        main.wide {
          width: calc(100vw - 1rem);
          max-width: 100%;
          overflow-x: hidden;
        }

        footer {
          padding: 1rem 0.5rem;
          font-size: 0.75rem;
        }

        header {
          padding: 0.5rem 0.6rem;
        }

        header .logo a {
          font-size: 1rem;
        }

        .global-back-button {
          width: 44px;
          height: 44px;
          margin-right: 0.35rem;
        }

        .close-btn {
          width: 44px;
          height: 44px;
        }
      }
      
      /* Tablet styles */
      @media (min-width: 768px) and (max-width: 1023px) {
        header {
          padding: 1rem 1.5rem;
        }
        
        header nav a {
          font-size: 0.7rem;
          padding: 0.45rem 0.4rem;
        }

        main {
          padding: 1.5rem;
        }
      }
      
      /* Desktop styles */
      @media (min-width: 1024px) {
        header {
          padding: 1rem 2rem;
        }
        
        main {
          padding: 2rem;
        }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="logo">
        {!isHome && (
          <button onclick="history.back()" class="global-back-button" type="button" title={t('header.back', locale)}>
            <span style="font-size: 1.2rem; line-height: 1;">←</span>
          </button>
        )}
        <a href={`${localePrefix(locale)}/`}>Archivist-Library</a>
      </div>
      <nav>
        <a href={`${localePrefix(locale)}/mutants`}>{t('nav.mutants', locale)}</a>
        <a href="/evolution/evotech-calculator">{t('nav.evoCalculator', locale)}</a>
        <a href="/simulators/stats">{t('nav.statsCalculator', locale)}</a>
        <a href="/materials">{t('nav.materials', locale)}</a>
        <a href="/simulators">{t('nav.simulators', locale)}</a>
        <a href="/simulators/breeding">{t('nav.breeding', locale)}</a>
        <a href="/bingo">{t('nav.bingo', locale)}</a>
        <a href="/boxes">{t('nav.boxes', locale)}</a>
        <a href="/tier-list">{t('nav.tierList', locale)}</a>
        <a href="/rebalance">{t('nav.rebalance', locale)}</a>
        <a href="/top-mutants">{t('nav.topMutants', locale)}</a>
        <a href="/guides">{t('nav.guides', locale)}</a>
        <a href="/credits">{t('nav.credits', locale)}</a>
        <a href="/top-evo">{t('nav.topEvo', locale)}</a>
      </nav>
      <SearchBox client:visible />
      <!-- Переключатель языка (Батч 11, i18n-пилот): на непереведённых страницах
           ведёт на локализованную главную, а не на 404 несуществующей страницы. -->
      <div class="lang-switcher">
        {TRANSLATED_UI_LOCALES.map((l) => (
          <a
            href={`${localePrefix(l)}${isPilotPage ? (pathWithoutLocale === '/' ? '' : pathWithoutLocale) : '/'}` || '/'}
            class={l === locale ? 'active' : ''}
            aria-current={l === locale ? 'true' : undefined}
          >{l.toUpperCase()}</a>
        ))}
      </div>
      <button class="menu-toggle" id="menuToggle" aria-label={t('header.openMenu', locale)}>
        <span></span>
        <span></span>
        <span></span>
      </button>
    </header>

    <!-- Mobile Navigation -->
    <div class="overlay" id="overlay"></div>
    <nav class="mobile-nav" id="mobileNav">
      <div class="mobile-nav-header">
        <h2>{t('mobileNav.title', locale)}</h2>
        <button class="close-btn" id="closeBtn" aria-label={t('header.closeMenu', locale)}>&times;</button>
      </div>
      <a href={`${localePrefix(locale)}/`}>{t('nav.home', locale)}</a>
      <a href={`${localePrefix(locale)}/mutants`}>{t('nav.mutants', locale)}</a>
      <a href="/simulators/stats">{t('nav.statsCalculator', locale)}</a>
      <a href="/evolution/evotech-calculator">{t('nav.evoCalculator', locale)}</a>
      <a href="/materials">{t('nav.materials', locale)}</a>
      <a href="/simulators">{t('nav.simulators', locale)}</a>
      <a href="/simulators/breeding">{t('nav.breeding', locale)}</a>
      <a href="/bingo">{t('nav.bingo', locale)}</a>
      <a href="/boxes">{t('nav.boxes', locale)}</a>
      <a href="/rebalance">{t('nav.rebalance', locale)}</a>
      <a href="/tier-list">{t('nav.tierList', locale)}</a>
      <a href="/top-mutants">{t('nav.topMutants', locale)}</a>
      <a href="/guides">{t('nav.guides', locale)}</a>
      <a href="/credits">{t('nav.credits', locale)}</a>
      <a href="/top-evo">{t('nav.topEvo', locale)}</a>
    </nav>

    <main class={fullWidth ? 'wide' : ''}>
      <slot />
    </main>
    <footer>
      <p>{t('footer.copyright', locale).replace('{year}', String(new Date().getFullYear()))}</p>
    </footer>
    
    <script>
      // Mobile menu toggle
      const menuToggle = document.getElementById('menuToggle');
      const mobileNav = document.getElementById('mobileNav');
      const overlay = document.getElementById('overlay');
      const closeBtn = document.getElementById('closeBtn');
      
      function openMenu() {
        menuToggle?.classList.add('active');
        mobileNav?.classList.add('active');
        overlay?.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
      
      function closeMenu() {
        menuToggle?.classList.remove('active');
        mobileNav?.classList.remove('active');
        overlay?.classList.remove('active');
        document.body.style.overflow = '';
      }
      
      menuToggle?.addEventListener('click', () => {
        if (mobileNav?.classList.contains('active')) {
          closeMenu();
        } else {
          openMenu();
        }
      });
      
      closeBtn?.addEventListener('click', closeMenu);
      overlay?.addEventListener('click', closeMenu);
      
      // Close menu when clicking on a link
      const mobileNavLinks = mobileNav?.querySelectorAll('a');
      mobileNavLinks?.forEach(link => {
        link.addEventListener('click', closeMenu);
      });

      // Запрет перетаскивания/открытия текстур в новой вкладке (крит-эффект +
      // правый клик "открыть картинку"/"сохранить как"). Это сдерживающий
      // барьер, не защита - через devtools картинку всё равно можно достать.
      document.addEventListener('dragstart', (e) => {
        if (e.target instanceof HTMLImageElement) e.preventDefault();
      });
      document.addEventListener('contextmenu', (e) => {
        if (e.target instanceof HTMLImageElement) e.preventDefault();
      });
    </script>
    <SpeedInsights />
    <Analytics />
  </body>
</html>
