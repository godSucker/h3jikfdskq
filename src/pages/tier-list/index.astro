---
export const prerender = true

import BaseLayout from '@/layouts/BaseLayout.astro'
import TierList from '@/components/TierList.svelte'
import mutants from '@/data/mutants/mutants.json'
import tierMeta from '@/data/mutants/tier-updated-at.json'

// Тиры живут прямо в mutants.json (поле `tier`); писать их может и
// телеграм-вебхук (src/pages/api/telegram-webhook.ts -> tier-parser.js), и
// редактор на превью-ветке (кнопка публикации в mutants.json на main) - оба
// пути обновляют tier-updated-at.json той же коммитной операцией, так что
// дата на странице не зависит от того, кто именно правил тиры последним.
const tieredMutants = mutants.filter((m) => m.name && String(m.tier ?? '').trim())

const tierUpdatedLabel = tierMeta.updatedAt
  ? new Date(tierMeta.updatedAt).toLocaleDateString('ru-RU', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    })
  : null
---

<BaseLayout title="Тир-лист мутантов" description="Актуальный тир-лист мутантов MGG (Mutants Genetic Gladiators) от сообщества." fullWidth>
  <div class="mb-3 sm:mb-4 text-center">
    <h1 class="text-lg sm:text-2xl font-extrabold text-white tracking-wide mb-1">
      Тир-лист лучших мутантов в PvP
    </h1>
    <p class="text-xs text-slate-300">
      {tierUpdatedLabel && `Обновлено: ${tierUpdatedLabel} `}Мутанты расположены по генам от Киборга до Мифика.
    </p>
  </div>

  <TierList client:load mutants={tieredMutants} />

  <p class="mt-4 sm:mt-6 text-[10px] sm:text-xs text-slate-300 leading-relaxed text-center max-w-3xl mx-auto">
    Напоминаем, что этот топ является субъективным виденьем меты игры админами группы. У нас есть неплохой игровой опыт и примерное понимание меты. Однако, в тире всегда могут быть неточности, всем людям не сойтись на одном мнении. Тир создан для примерного понимания силы мутантов и упрощенного восприятия общей картины игрового баланса.
  </p>
</BaseLayout>
