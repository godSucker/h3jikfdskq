---
export const prerender = true;
import BaseLayout from '@/layouts/BaseLayout.astro';
import StatsCalculator from '@/components/StatsCalculator.svelte';
---

<BaseLayout title="Калькулятор статов" description="Калькулятор статов мутантов MGG (Mutants Genetic Gladiators): уровень, звёзды, сферы, сравнение двух мутантов.">
  <section class="intro">
    <h1>Калькулятор статов MGG</h1>
    <p>
      Калькулятор статов любого мутанта в Mutants Genetic Gladiators с возможностью указать звезды
      (бронза/серебро/золото/платина) и сферы. Можно сравнить двух мутантов сразу.
    </p>
  </section>
  <StatsCalculator client:load />
</BaseLayout>

<style>
  .intro {
    max-width: 900px;
    margin: 0 auto 1rem;
    padding: 0 1rem;
  }
  .intro h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.4rem, 1.1rem + 1vw, 2rem);
    color: #f8fafc;
  }
  .intro p {
    margin: 0;
    color: #e5e7eb;
  }
</style>
